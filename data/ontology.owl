    <!-- https://w3id.org/arco/ontology/arco/isHeritageProtectionAgencyOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/arco/isHeritageProtectionAgencyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/arco/isRelatedAgencyOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/arco/hasRelatedAgency"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/arco/CulturalProperty"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la relazione che collega un ente competente per la tutela al relativo bene culturale della cui tutela è competente. La relazione tra il ruolo e l&apos;ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell&apos;ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe AgentRole, che permette di collegare l&apos;ente e il suo ruolo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an heritage protection agency to the cultural property. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">is heritage protection agency of</rdfs:label>
        <rdfs:label xml:lang="it">è ente competente per la tutela di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: CD/ECP</ns1:iccdNormTag>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isHeritageProtectionAgencyOf"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/isMainDisciplineOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/arco/isMainDisciplineOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/SubjectDiscipline"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/arco/CulturalProperty"/>
        <rdfs:comment xml:lang="it">Questa proprietà permette di associare la disciplina scientifica principale, cui un bene culturale fa riferimento, al bene culturale stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the main scientific discipline related to a cultural property to that cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">is main discipline of</rdfs:label>
        <rdfs:label xml:lang="it">è disciplina principale di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/isMibacScopeOfProtectionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/arco/isMibacScopeOfProtectionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/arco/MibacScopeOfProtection"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/arco/CulturalProperty"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &quot;ha ambito di tutela&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has MiBAC scope of protection&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">is MiBAC scope of protection of</rdfs:label>
        <rdfs:label xml:lang="it">è ambito di tutela di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/isRelatedAgencyOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/arco/isRelatedAgencyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/arco/CulturalProperty"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa a &quot;ha ente collegato&quot;, rappresenta la relazione che collega un ente che riveste un ruolo nei confronti di un bene culturale al bene culturale stesso. La relazione tra il ruolo e l&apos;ente che lo riveste è espressa, in maniera generica, nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. La proprietà è specializzata per mezzo di sottoproprietà. Nell&apos;ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l&apos;ente, il suo ruolo e la sua corrispondente estensione temporale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property, inverse of &quot;has related agency&quot;, relates an agency that plays a role related to a cultural property to that cultural property. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">is related agency of</rdfs:label>
        <rdfs:label xml:lang="it">è ente collegato a</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:constructQuery>CONSTRUCT {
?x &lt;https://w3id.org/arco/ontology/arco-lite/isRelatedAgentOf&gt; ?y .
}

WHERE {
?x arco:isRelatedAgencyOf ?y .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isRelatedAgentOf"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/catalogue/editedAtTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/catalogue/editedAtTime">
