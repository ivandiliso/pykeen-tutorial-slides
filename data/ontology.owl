    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasMineralDeposit">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasNaturalEnvironment -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasNaturalEnvironment">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isNaturalEnvironmentOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
