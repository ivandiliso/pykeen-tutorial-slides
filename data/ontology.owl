    <!-- https://w3id.org/arco/ontology/denotative-description/isSupportOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/isSupportOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/Support"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/denotative-description/AffixedElement"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa di &quot;ha supporto&quot;, collega un supporto (es.: &quot;etichetta di carta&quot;) all&apos;elemento (timbro, emblema, iscrizione, marchio) che vi viene rappresentato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property connects a support (e.g. &quot;paper label&quot;) to an element (stamp, embelem, inscription, mark) which has been represented on it. It is the inverse property of hasSupport.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/denotative-description"/>
        <rdfs:label xml:lang="en">is support of</rdfs:label>
        <rdfs:label xml:lang="it">è supporto di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DA/ISE/ISES</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/isTechnicalCharacteristicOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/isTechnicalCharacteristicOf">
