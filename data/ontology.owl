        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isNaturalEnvironmentOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/NaturalEnvironment"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="it">Questa proprietà collega una cosa all&apos;ambiente naturale in cui è inserita</rdfs:label>
        <rdfs:label xml:lang="en">This property relates a thing to its natural environment</rdfs:label>
        <rdfs:label xml:lang="it">ha ambiente naturale</rdfs:label>
        <rdfs:label xml:lang="en">has natual environment</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasOldTownAdministrativeType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasOldTownAdministrativeType">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isOldTownAdministrativeTypeOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasConcept"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasType"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isConceptOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isTypeOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isOldTownAdministrativeTypeOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/location/OldTown"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/OldTownAdmistrativeType"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un centro storico con le informazioni relative al tipo del suo carattere amministrativo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property connects a historical center with information related to its administrative type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">Old town administrative type</rdfs:label>
        <rdfs:label xml:lang="it">Tipo amministrativo del centro storico</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normative A e PG: LC/CST/CSTA</ns1:iccdNormTag>
        <ns2:constructQuery>CONSTRUCT   { 
?x a a-loc:OldTown;
core:hasType ?type.
}

WHERE       { 
?x a a-loc:OldTown;
a-loc:hasOldTownAdministrativeType ?type.
 }</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/core/hasType"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasOutcrop -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasOutcrop">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasShadeTolerance -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasShadeTolerance">
