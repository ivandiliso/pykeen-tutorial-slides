            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="it">Questa classe rappresenta il tipo di catasto (ad es. catasto terreni, catasto fabbricati, catasto misto).</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents the type of cadastre (e.g. land cadastre, building cadastre, mixed cadastre).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">Cadastre type</rdfs:label>
        <rdfs:label xml:lang="it">Tipo di catasto</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: CS/CTS/CTST</ns1:iccdNormTag>
    </owl:Class>
    


    <!-- https://w3id.org/arco/ontology/location/ChronostratigraphicClass -->

    <owl:Class rdf:about="https://w3id.org/arco/ontology/location/ChronostratigraphicClass">
