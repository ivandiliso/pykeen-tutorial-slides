        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has functional purpose&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is functional purpose of</rdfs:label>
        <rdfs:label xml:lang="it">è scopo funzionale di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale: DA/ISE/ISEC - Normative di versioni precedenti: DA/ISR/ISRC; DA/APF/APFF</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isInterpretationCriterionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isInterpretationCriterionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/isDescriptionOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/hasDescription"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/InterpretationCriterion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un criterio interpretativo all&apos;interpretazione che si è basata su quel criterio.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an interpretation criterion to the interpretation that was based on that criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is interpretation criterion of</rdfs:label>
        <rdfs:label xml:lang="it">è criterio interpretativo di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isInterventionOn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isInterventionOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa a &quot;ha intervento&quot;, collega un intervento, a fini conservativi o di altro tipo, che ha interessato un bene culturale, al bene stesso.</rdfs:comment>
        <rdfs:comment xml:lang="it">This property relates an intervention on a cultural property to that cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is intervention on</rdfs:label>
        <rdfs:label xml:lang="it">è intervento su</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: CO/RST; normative di versioni precedenti: RS/RST - Normativa VeAC: CO/RIA - Normativa CA: RO/RIS</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isInterventionRoleIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isInterventionRoleIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isRoleOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasRole"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/RO/withRole"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/RO/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/Responsibility"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &quot;ha ruolo nell&apos;intervento&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has intervention role&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is intervention role in</rdfs:label>
        <rdfs:label xml:lang="it">è ruolo nell&apos;intervento</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>AU/ATB/ATBR; AU/AUT/AUTR.
ICCD Normative F e FF: PD/PDF/PDFR</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isInventoryOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isInventoryOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Inventory"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/InventorySituation"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un inventario che registra informazioni relative al bene culturale al bene culturale o alle entità o attività collegate al bene culturale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an inventory to a cultural property or an entity or an activity related to it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is inventory of</rdfs:label>
        <rdfs:label xml:lang="it">è inventario di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>UB/INV; ICCD Normativa Trasversale: UB/INP. -  ICCD Normativa RA 3.00 RE/DSC/DSCI</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isInventorySituationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isInventorySituationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/InventorySituation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega la situazione inventariale a una cosa.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the inventory situation to an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is inventory situation of</rdfs:label>
        <rdfs:label xml:lang="it">è situazione inventariale di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>UB/INV; ICCD Normativa Trasversale: UB/INP.</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isInvolvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isInvolvedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedWork"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/isWorkRelatedTo"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un bene culturale a un altro bene culturale collegato, di tipo immateriale, in cui è coinvolto.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a cultural entity to another involved  cultural entity (e.g. immaterial).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is involved in</rdfs:label>
        <rdfs:label xml:lang="it">è coinvolto in</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RV/RSE/RSER = &apos;è coinvolto in&apos; (versioni precedenti: &apos;esecuzione/evento di riferimento&apos;)</ns1:iccdNormTag>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?x a-lite:isInvolvedIn ?y .
}

WHERE {
?x a-cd:isInvolvedIn ?y .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isInvolvedIn"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isLegalSituationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isLegalSituationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/LegalSituation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una condizione giuridica a un&apos;entità che si trova in quella condizione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a legal situation to an entity that is in that situation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is legal situation of</rdfs:label>
        <rdfs:label xml:lang="it">è condizione giuridica di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/CDG. - RP/LGC/LGCO. LS/CSS/CSSP. - CS/CTS/CTSP</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isLicenseOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isLicenseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/License"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una licenza d&apos;uso ad un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a license to an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is license of</rdfs:label>
        <rdfs:label xml:lang="it">è licenza di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa SCAN: DO/DCM/DCML</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isLocatedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isLocatedIn">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/isLocationOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedWork"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/isWorkRelatedTo"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/isLocationOf"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un bene culturale a un altro bene culturale collegato, che ne costituisce il luogo di collocazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a cultural entity to a connected cultural entity which constitutes its location area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">ha luogo di collocazione</rdfs:label>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
        <rdfs:label xml:lang="it">è contenuto in</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale 4.00: RV/RSE/RSER = &apos;è contenuto in&apos; (versioni precedenti: &apos;luogo di collocazione/localizzazione&apos;; &apos;scheda contenitore&apos;)</ns1:iccdNormTag>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?x a-lite:isLocatedIn ?y .
}

WHERE {
?x a-cd:isLocatedIn ?y .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isLocatedIn"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isLocationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isLocationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/isWorkRelatedTo"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedWork"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa di &apos;is located in&apos;, collega un bene culturale a un altro bene culturale collegato, che costituisce il luogo di collocazione del primo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property, inverse of &apos;is located in&apos;, relates a cultural entity to a connected cultural entity, which constitutes its location area.</rdfs:comment>
        <rdfs:comment>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?cult a-lite:isLocationOf ?cultsec .
}

WHERE {
?cult a-cd:isLocationOf ?cultsec .
}</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is location of</rdfs:label>
        <rdfs:label xml:lang="it">è luogo di collocazione di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isLocationOf"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isMemberInvolvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isMemberInvolvedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/CollectionMembership"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un bene culturale mobile alla classe che rappresenta l&apos;appartenenza del bene culturale a una collezione in un certo intervallo di tempo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a cultural property to the class that represents the membership relation between this cultural property and a collection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is member involved in</rdfs:label>
        <rdfs:label xml:lang="it">è membro coinvolto in</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isMemberOfCollection -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isMemberOfCollection">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isObjectAssociatedTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isObjectAssociatedTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa è la proprietò inversa a &quot;ha oggetto associato&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has associated object&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is object associated to</rdfs:label>
        <rdfs:label xml:lang="it">è oggetto associato a</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa AT 3.01: OG/OGC/OGCE</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isPreferredAuthorOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isPreferredAuthorOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/isAgentRelatedTo"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedAgent"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un agent a una entità di qualsiasi tipo (documentazione, bene culturale, etc.) di cui quell&apos;agente è autore preferito.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an agent to an entity the agent is preferred author of.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is preferrede author of</rdfs:label>
        <rdfs:label xml:lang="it">è autore preferito di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?agent a-lite:isPreferredAuthorOf ?thing .
}

WHERE {
?agent a-cd:isPreferredAuthorOf ?thing .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isPreferredAuthorOf"/>
        <ns2:replacingQuery>select * where {
?agent core:isAgentOf ?NEWagentRole .
?NEWagentRole core:hasRole &lt;https://w3id.org/arco/resource/Role/PreferredAuthor&gt; ;
core:isAgentRoleOf ?thing .
}</ns2:replacingQuery>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isProfessionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isProfessionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Profession"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &quot;ha professione&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has profession&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is profession of</rdfs:label>
        <rdfs:label xml:lang="it">è professione di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDM 2.00: UT/UTN/UTNM - ICCD Normativa BDM 4.00: AU/AUT/AUTE. BDI: AT/ATT/ATTM, AI/AIF/AIFM, VI/VIF/VIFM, FI/FIF/FIFM. SM: MU/MUT/MUTM. Normativa AUT 4.00: AU/AUT/AUTQ</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isProponentAgencyOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isProponentAgencyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/isAgentRelatedTo"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedAgent"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://dati.beniculturali.it/cis/CulturalEntity"/>
                    <rdf:Description rdf:about="https://w3id.org/arco/ontology/context-description/ProtectiveMeasure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="it">Questa proprietà collega all&apos;ente proponente, ovvero il soggetto che ha proposto il provvedimento (identificato per mezzo della denominazione per esteso oppure, nel caso di Enti accreditati dall&apos;ICCD, del relativo codice assegnato dall&apos;Istituto) al provvedimento di tutela relativo al bene culturale, oppure direttamente al bene culturale. La relazione tra il ruolo e l&apos;agente che lo riveste è espressa, in maniera generica, nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell&apos;ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe AgentRole, che permette di collegare l&apos;agente e il suo ruolo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an agent that is a proponent agency of a protective measure of a cultural property to the protective measure or to the cultural entity itself. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is proponent agency of</rdfs:label>
        <rdfs:label xml:lang="it">è ente proponente di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/NVC/NVCA</ns1:iccdNormTag>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?agent a-lite:isProponentAgencyOf ?thing .
}

WHERE {
?agent a-cd:isProponentAgencyOf ?thing .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isProponentAgencyOf"/>
        <ns2:replacingQuery>select * where {
?agent core:isAgentOf ?NEWagentRole .
?NEWagentRole core:hasRole &lt;https://w3id.org/arco/resource/Role/ProponentAgency&gt; ;
core:isAgentRoleOf ?thing .
}</ns2:replacingQuery>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isProtectiveMeasureOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isProtectiveMeasureOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ProtectiveMeasure"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un provvedimento di tutela nazionale o internazionale al bene culturale cui si applica.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an international or national protective measure to the cultural enitity to which it is applied.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is protective measure of</rdfs:label>
        <rdfs:label xml:lang="it">è provvedimento di tutela di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/NVC</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isRecordingOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isRecordingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Recording"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una registrazione alla rispettiva entità culturale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a recording to the related cultural entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is recording of</rdfs:label>
        <rdfs:label xml:lang="it">è registrazione di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDI: DU</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isRelatedWorkInvolvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isRelatedWorkInvolvedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/RelatedWorkSituation"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;opera collegata a un bene culturale al rapporto tra l&apos;opera e il bene culturale (es.: un lavoro preparatorio, un prototipo, una copia, un reimpiego di tutto il bene o di una sua parte, ecc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a work related to a cultural property (e.g.: a preparatory work, a prototype, a copy, a reuse, etc.) to the situation in which that work is related to the cultural property itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is related work involved in</rdfs:label>
        <rdfs:label xml:lang="it">è opera collegata coinvolta in</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isRelatedWorkSituationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isRelatedWorkSituationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/RelatedWorkSituation"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa di &apos;ha rapporto con opera collegata&apos;, collega la relazione tra il bene culturale e un&apos;altra opera che ne costituisce una fase preparatoria o che ne rappresenta la fase finale al bene culturale stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property, inverse of &apos;has related work situation&apos;, relates a situation in which a cultural property is related to another work, that could even be another cultural property, to the cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is related work situation of</rdfs:label>
        <rdfs:label xml:lang="it">è rapporto con opera collegata di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isRelationshipTypeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isRelationshipTypeOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isConceptOf"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isTypeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasConcept"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasType"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/RelationshipType"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/RelatedWorkSituation"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il tipo di relazione tra due beni alla situazione che ne descrive la relazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the type of relationship between two cultural property and the related work situation itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is relationship type of</rdfs:label>
        <rdfs:label xml:lang="it">è tipo di relazione di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale: ROFF
ICCD Normativa VeAC: AU/AUT/AUTO</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isReliabilityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isReliabilityOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isCharacteristicOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasCharacteristic"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Reliability"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il livello di affidabilità delle informazioni rilevate nell&apos;indagine a una fotointerpretazione o fotorestituzione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the reliability of the information collected during the survey to a photo interpretation rendering survey.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is reliability of</rdfs:label>
        <rdfs:label xml:lang="it">è affidabilità di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isResearchOn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isResearchOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Research"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà la ricerca ad un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a research to an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is research on</rdfs:label>
        <rdfs:label xml:lang="it">è ricerca su</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa SM e BDM 4.00: DR/DRT</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isResponsibilityFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isResponsibilityFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isAgentRoleOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasAgentRole"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Responsibility"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">This property relates the attribution of a responsibility to an agent, relating to the activities of production and dissemination of photographic heritage (e.g.: committent, editor, printer, dedicatee, etc.) to photographic heritage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is responsibility for</rdfs:label>
        <rdfs:label xml:lang="it">è responsibilità su</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa F: PD/PDF</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isResponsibleForInsertionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isResponsibleForInsertionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/isAgentRelatedTo"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedAgent"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/CurrentInventory"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il responsabile dell&apos;inventariazione patrimoniale del bene all&apos;inventario patrimoniale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the agent responsible for the cultural entity&apos;s inventory to the current inventory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is responsible for insertion of</rdfs:label>
        <rdfs:label xml:lang="it">è responsabile dell&apos;immissione in patrimonio di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?agent a-lite:isResponsibleAgentOf ?thing .
}

WHERE {
?agent a-cd:isResponsibleForInsertionOf ?thing .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isResponsibleAgentOf"/>
        <ns2:replacingQuery>select * where {
?agent core:isAgentOf ?NEWagentRole .
?NEWagentRole core:hasRole &lt;https://w3id.org/arco/resource/Role/ResponsibleAgent&gt; ;
core:isAgentRoleOf ?thing .
}</ns2:replacingQuery>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isReusedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isReusedBy">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/reuses"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedWork"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/isWorkRelatedTo"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/reuses"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un bene culturale a un altro bene culturale collegato che lo riutilizza in tutto o in parte.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a cultural entity to a connected cultural entity that reuse it or a part of it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is reused by</rdfs:label>
        <rdfs:label xml:lang="it">è riutilizzato in</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale 4.00: RV/RSE/RSER = &apos;è riutilizzato in&apos; (versioni precedenti: &apos;bene composto&apos;)</ns1:iccdNormTag>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?x a-lite:isReusedBy ?y .
}

WHERE {
?x a-cd:isReusedBy ?y .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isReusedBy"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isReviewOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isReviewOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;attività di revisione a un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a review activity to an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is review of</rdfs:label>
        <rdfs:label xml:lang="it">è revisione di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativia BNB: RB/RBR. Normativa BNM: RM. Normativa BNPL: RP. Normativa BNPE: RR</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSexInterpretationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSexInterpretationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isSituationOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasSituation"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is sex interpretation of</rdfs:label>
        <rdfs:label xml:lang="it">è interpretazione del sesso di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <ns2:constructQuery>CONSTRUCT {
?sexint a a-cd:Sex .
?sexint a-cd:isSexOf ?cultent .
}

WHERE {
?sexint a-cd:isSexInterpretationOf ?cultent .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/context-description/isSexOf"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSexOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSexOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Sex"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il sesso di un&apos;entità all&apos;entità stessa.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the sex to the entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is sex of</rdfs:label>
        <rdfs:label xml:lang="it">è sesso di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">unstable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSpecificBibliographicSourceOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSpecificBibliographicSourceOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/isBibliographicSourceOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasBibliographicSource"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Edition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;edizione dell&apos;opera parte della bibliografia specifica con l&apos;entità di cui è bibliografia.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the edition of the work part of the specific bibliography to the involved entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is specific bibliographic source of</rdfs:label>
        <rdfs:label xml:lang="it">è fonte bibliografica specifica di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isStorageMediumOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isStorageMediumOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/StorageMedium"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/Recording"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il supporto di archiviazione di una registrazione con la registrazione stessa.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the storage medium of a recording to the recording itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is storage medium of</rdfs:label>
        <rdfs:label xml:lang="it">è supporto di memoria di</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDI: DU/DUO, DU/DUM, DV/DVM, DV/DVO, AI/AIO, AI/AIM, VI/VIO, VI/VIM</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isStratigraphicUnitOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isStratigraphicUnitOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isLocationOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasLocation"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/StratigraphicUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;unità stratigrafica dalla quale proviene il bene rinvenuto nello scavo al relativo scavo archeologico.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the stratigraphic unit from which a cultural property has been found to the related archeological excavation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is stratigraphic unit of</rdfs:label>
        <rdfs:label xml:lang="it">è unità stratigrafica di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/DSC/DSCU</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSubjectOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSubjectOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa a &quot;ha soggetto&quot;, collega un soggetto o motivo ornamentale al bene culturale o a un&apos;opera correlata a un bene culturale in quanto sua fase preparatoria o finale o a un apparato iconografico-decorativo su cui è rappresentato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a subject or ornamental motif to the cultural property or to the final or preparatory work of a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is subject of</rdfs:label>
        <rdfs:label xml:lang="it">è soggetto di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale: DA/AID/AIDI - Normativa F: SG/SGT/SGTI - Altre normative di versioni precedenti alla 4.00: OG/SGT/SGTI - ICCD Normative F, RA, SMO, PST, S, OAC, OA, MI, D, NU: RO/ROF/ROFS</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSurveyImageOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSurveyImageOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/SurveyImage"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &quot;ha immagine di indagine&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has survey image&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is survey image of</rdfs:label>
        <rdfs:label xml:lang="it">è immagine di indagine</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/FOI/FOIT + FOID</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSurveyMethodOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSurveyMethodOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isDescriptionOf"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isMethodOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasDescription"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasMethod"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/SurveyMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/Survey"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il metodo adottato nel corso di un&apos;indagine all&apos;indagine stessa.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the method adopted in a survey to the survey itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is survery method of</rdfs:label>
        <rdfs:label xml:lang="it">è metodo di indagine di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/RCG/RCGM; RE/DSC/DSCM - ICCD Normativa AT: PT/PTC/PTCM</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSurveyMotivationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSurveyMotivationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/isDescriptionOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/hasDescription"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/SurveyMotivation"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/Survey"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il motivo principale che ha determinato uno scavo archeologico, una ricognizione archeologica, un&apos;indagine archeometrica e diagnostica o una fotointerpretazione e fotorestituzione a ciascuno di essi.</rdfs:comment>
        <rdfs:comment xml:lang="it">This property relates the main motivation that led to an archeological, archaeometric or diagnostic survey or a photo interpretation rendering to each of them.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is survey motivation of</rdfs:label>
        <rdfs:label xml:lang="it">è motivo di indagine di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa Trasversale: RE/RCG/RCGE; RE/DSC/DSCT; RE/IND/INDM; RE/FOI/FOIM</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isSurveyOn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isSurveyOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Survey"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;indagine effettuata su un bene culturale al bene stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a cultural entity&apos;s survey to the cultural entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is survey on</rdfs:label>
        <rdfs:label xml:lang="it">è indagine su</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE; CM/ISP - ICCD Normative NU, RA, BNB, MA, CA: RS/ALB - ICCD Normativa AT 3.00: IN/INI - Normativa BDM e SM 4.00: DR</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isTimeIntervalFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isTimeIntervalFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/TI/TimeInterval"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/Dating"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un intervallo di tempo con la datazione di un evento relativo a un bene culturale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a time interval to the dating related to a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is time interval for</rdfs:label>
        <rdfs:label xml:lang="it">è intervallo di tempo per</rdfs:label>
        <owl:versionInfo xml:lang="it">intabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isTitleOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isTitleOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Title"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un titolo all&apos;entità cui si riferisce.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a title to the entity to which it is referred.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is title of</rdfs:label>
        <rdfs:label xml:lang="it">è titolo di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>OG/SGT/SGTP; SG/SGL/SGLT; SG/SGL/SGLL; OG/SGT/SGTR; DA/AID/AIDN; SG/SGL/SGLA; DA/AID/AIDT; OG/SGT/SGTT; RO/ROF/ROFT; DO/BSE/BSET; DO/BSE/BSEC.</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isTombOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isTombOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Tomb"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &quot;ha deposizione funeraria&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has tomb&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is tomb of</rdfs:label>
        <rdfs:label xml:lang="it">è deposizione funeraria di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/DSC/DSCS</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isUrbanPlanningInstrumentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isUrbanPlanningInstrumentOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/UrbanPlanningInstrument"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega uno strumento urbanistico-territoriale, ovvero un piano regolatore generale e particolareggiato o un piano paesaggistico che interessa un bene culturale al bene stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class relates a urban planning instrument to the related cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is urban planning instrument of</rdfs:label>
        <rdfs:label xml:lang="it">è strumento urbanistico-territoriale di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/STU</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isUseFunctionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isUseFunctionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/UseFunction"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/context-description/Use"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega la funzione d&apos;uso di un&apos;entità alla relativa entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the use function of an entity to the related entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is use function of</rdfs:label>
        <rdfs:label xml:lang="it">è funzione d&apos;uso di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isUseOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isUseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Use"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;uso di un bene culturale con il bene culturale stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the use of a cultural entity to the related cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is use of</rdfs:label>
        <rdfs:label xml:lang="it">è uso di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale: UT</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/isWorkRelatedTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/isWorkRelatedTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa a &quot;ha opera collegata&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has related work&quot;.</rdfs:comment>
        <rdfs:comment>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?cult a-lite:isWorkRelatedTo ?cultsec .
}

WHERE {
?cult a-cd:isWorlRelatedTo ?cultsec .
}</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">is work related to</rdfs:label>
        <rdfs:label xml:lang="it">è opera collegata a</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isWorkRelatedTo"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/reuses -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/context-description/reuses">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/context-description/isWorkRelatedTo"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/context-description/hasRelatedWork"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &apos;è riutilizzato da&apos;, che collega un bene culturale a un altro bene culturale collegato che lo riutilizza in tutto o in parte.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the invers property of &apos;is reused by&apos;, which relates a cultural entity to a connected cultural entity that reuse it or a part of it.</rdfs:comment>
        <rdfs:comment>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?cult a-lite:reuses ?cultsec .
}

WHERE {
?cult a-cd:reuses ?cultsec .
}</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">reuses</rdfs:label>
        <rdfs:label xml:lang="it">riutilizza</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/reuses"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/classifies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/classifies">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isClassifiedBy"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isClassifiedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/core/Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un concetto ad un&apos;entità</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a concept to an entity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="it">classifica</rdfs:label>
        <rdfs:label xml:lang="en">classifies</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa trasversale: */SGT/SGTI, DA/AID/AIDI, RO/ROF/ROFS, */THS/THSD. VeAC: OG/OGT/OGTV. SM: CL/CHS/CHSN, CL/CLA/CLAT</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/definesConcept -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/definesConcept">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isDefinedByClassificationSystem"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isDefinedByClassificationSystem"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/core/ClassificationSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/core/Concept"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega sistema di classificazione al concetto</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a classification system to a concept</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="en">defines concept</rdfs:label>
        <rdfs:label xml:lang="it">definisce concetto</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa trasversale e normative precedenti 4.00: SG/CLF/CLFT. SM: CL/CLA/CLAA. Normativa BNM: SM/SMS/SMSX, SMSC, SMSD, RM/RMS/RMSX, RMSK</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/describes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/describes">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isDescribedBy"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isDescribedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà è stata creata come proprietà generica di sottoproprietà specifiche, e rappresenta la relazione tra un&apos;entità che descrive un&apos;altra entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property was created as a generic property for specific subproperties, and represents the relationship between an entity that describes another entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="en">describes</rdfs:label>
        <rdfs:label xml:lang="it">descrive</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Tutte le schede di catalogo descrivono un bene. ICCD Normativa Tr: AC/ACS, AC/MOD</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/hasAgent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/hasAgent">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isAgentOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/RO/isRoleInTimeOf"/>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isAgentOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/core/AgentRole"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/core/Agent"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una situazione in cui un ruolo viene ricoperto da un agente all&apos;agente che lo ricopre.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a situation in which an agent holds a role to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="it">ha agente</rdfs:label>
        <rdfs:label xml:lang="en">has agent</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
