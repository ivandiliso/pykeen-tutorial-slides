        <rdfs:label xml:lang="en">is age range involved in</rdfs:label>
        <rdfs:label xml:lang="it">è fascia d&apos;età coinvolta in</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/isCharacteristicClassifiedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/isCharacteristicClassifiedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasConcept"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isConceptOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/denotative-description/TechnicalConcept"/>
        <ns3:isNativeTo rdf:resource="https://w3id.org/arco/pattern/technical-characteristic/"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una caratteristica tecnica di un&apos;entità - come un bene culturale - a un concetto tecnico, che la classifica.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property connects an entity&apos;s techincal characteristic to a technical concept, which classifies that characteristic.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">is technical characteristic classified by</rdfs:label>
        <rdfs:label xml:lang="it">è caratteristica tecnica classificata da</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/isCommunicationMediumOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/isCommunicationMediumOf">
