                <owl:someValuesFrom rdf:resource="https://w3id.org/italia/onto/CLV/Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="it">Questa classe rappresenta l indirizzo storico, inteso come il contesto topografico e amministrativo storico.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents the historical address, as the topographical and administrative historical context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">Historical address</rdfs:label>
        <rdfs:label xml:lang="it">Indirizzo storico</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa trasversale: LS/LCS</ns1:iccdNormTag>
    </owl:Class>
    


