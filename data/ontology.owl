        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/MarineBiogeographicRealm"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un ambiente naturale alla sua regione zoogeografica marina.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property connects a natural environment with its marine biogeographic realm.</rdfs:comment>
        <rdfs:label xml:lang="it">ha regione biogeografica marina</rdfs:label>
        <rdfs:label xml:lang="en">has marine biogeographic realm</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BNZ: LR/LRM</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


