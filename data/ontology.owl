        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/core/Taxon"/>
        <rdfs:comment xml:lang="it">Questa proprietà mette in relazione il campione  con il taxon che lo identifica.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the sample to the taxon that identifies it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is identified by</rdfs:label>
        <rdfs:label xml:lang="it">è identificato da</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/isMineralDepositOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/isMineralDepositOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/MineralDeposit"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/GeologicalContext"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il deposito mineralogico al contesto geologico</rdfs:comment>
        <rdfs:comment xml:lang="en">This property realtes the mineral deposit the geological context</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is mineral deposit of</rdfs:label>
        <rdfs:label xml:lang="it">è deposito mineralogico di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/isOutcropOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/isOutcropOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/Outcrop"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/GeologicalContext"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;affioramento al contesto geologico</rdfs:comment>
        <rdfs:comment xml:lang="en">This property realtes the outcrop the geological context</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is outcrop of</rdfs:label>
        <rdfs:label xml:lang="it">è affioramento di</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/isRelatedSampleOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/isRelatedSampleOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/Sample"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il reperto della collezione ancillare al campione di riferimento</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a sample belonging to ancillary collection to a specimen</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is related sample of</rdfs:label>
        <rdfs:label xml:lang="it">è reperto associato di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/isSpecimenHarvestingOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/isSpecimenHarvestingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/SpecimenHarvesting"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega le informazioni sulla raccolta del campione al campione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the information about harvesting of the specimen to  its specimen</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is specimen harvesting of</rdfs:label>
        <rdfs:label xml:lang="it">è raccolta del campione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/isTypeOfTypeSpecimenFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/isTypeOfTypeSpecimenFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isConceptOf"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isTypeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasConcept"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasType"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/TypeOfTypeSpecimen"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/Typification"/>
        <rdfs:comment xml:lang="en">This property relates the type of type specimen to  the identification of a type specimen</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is type of type specimen for</rdfs:label>
        <rdfs:label xml:lang="it">è tipo di campione nomenclaturale per</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/isTypificationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/isTypificationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/Typification"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;individiazione del tipo nomenclaturale al campione</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the typification to the specimen</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="en">is typifcation of</rdfs:label>
        <rdfs:label xml:lang="it">è identificazione del tipo nomenclaturale di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BNB: SB/TBI</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/producesTaxon -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/producesTaxon">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/Typification"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/core/Taxon"/>
        <rdfs:comment xml:lang="it">Questa poprietà collega l&apos;identificazione del tipo nomenclaturale al taxon prodotto</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a Type specimen identification to the taxon it produces</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="it">produce taxon</rdfs:label>
        <rdfs:label xml:lang="en">produces taxon</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasAddress -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasAddress">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isAddressFor"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isAddressFor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:comment xml:lang="it">Questa proprietà consente di collegare una cosa del dominio da modellare con l&apos;indirizzo attuale, corrente.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property is used to link a thing to a current address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha indirizzo attuale</rdfs:label>
        <rdfs:label xml:lang="en">has current address</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasAddressComponent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasAddressComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AddressComponent"/>
        <rdfs:comment xml:lang="en">Property that links an address to its components (street, city, province, number, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che lega l&apos;indirizzo alle sue componenti che lo formano (e.g., via, città, provincia, numero civico, ecc.)</rdfs:comment>
        <rdfs:comment>Normativa A e PG: LC/ZUR/ZURD, LC/CST/CSTD, LC/SET/SETD</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha componente indirizzo</rdfs:label>
        <rdfs:label xml:lang="en">has address component</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasAdressinTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasAdressinTime">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isAddressInTimeFor"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isAddressInTimeFor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:comment xml:lang="en">Property that links any thing of the modelled domain with the situation of an address that changes over time.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che lega una qualsiasi cosa del dominio modellato alla situazione utilizzata per esprimere il cambiamento di un indirizzo nel tempo.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha indirizzo nel tempo</rdfs:label>
        <rdfs:label xml:lang="en">has address in time</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasCensusSection -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasCensusSection">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/Address"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/AddressArea"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/City"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/CensusSection"/>
        <rdfs:comment xml:lang="en">Property that links an address, a specific city or an address area to its census section.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che collega un accesso esterno, una città o un area dell&apos;indirizzo a una sezione di censimento.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha sezione di censimento</rdfs:label>
        <rdfs:label xml:lang="en">has census section</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasDirectHigherRank -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasDirectHigherRank">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/hasHigherRank"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:comment xml:lang="it">Questa proprietà mette in relazione componenti dell&apos;indirizzo con un nome, dove la prima è più specifica della seconda e non c&apos;è un altra componente con nome che è sia più generale della prima che più specifica della seconda.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates two named address components, where the first is more specific then the second and there is no other named address component that is both more general than the first and more specific than the second.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha livello più alto diretto</rdfs:label>
        <rdfs:label xml:lang="en">has direct higher rank</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasDirectLowerRank -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasDirectLowerRank">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/hasLowerRank"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:comment xml:lang="it">Questa proprietà mette in relazione componenti dell&apos;indirizzo con un nome, dove la prima è meno specifica della seconda e non esise un&apos;altra componente dell&apos;indirizzo con nome che è sia più specifica della prima che più generale della seconda.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates two named address components, where the first is less specific then the second and there is no other named address component that is both more specific than the first and more general than the second.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha livello diretto più basso</rdfs:label>
        <rdfs:label xml:lang="en">has direct lower rank</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasGeometry -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasGeometry">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isGeometryFor"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isGeometryFor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:comment xml:lang="it">Questa proprietà lega una qualsiasi cosa del dominio a una geometria.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links any thing of the domain to the geometry.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha geometria</rdfs:label>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasGeometryType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasGeometryType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/GeometryType"/>
        <rdfs:comment xml:lang="en">Property that links the Geometry to its Type (Polygon, Point, Line)</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che collega la geometria al suo tipo (poligono, punto, linea).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha tipo geometria</rdfs:label>
        <rdfs:label xml:lang="en">has geometry type</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasHigherRank -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasHigherRank">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:comment xml:lang="it">Questa proprietà è utilizzata per mettere in relazione due componenti dell&apos;indirizzo che hanno un nome, dove la prima è più specifica della seconda.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property is used to  relate two named address component, where the first is more specific than the second.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha livello più alto</rdfs:label>
        <rdfs:label xml:lang="en">has higher rank</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasIdentifier -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/SpatialObject"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Identifier"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un oggetto spaziale alla classe identificativo che rappresenta uno o più identificativi associabili a un oggetto spaziale. La proprietà è ereditata da tutte le sotto classi di oggetto spaziale. Esempi di identificativi sono il codice istat, l&apos;identificativo di un indirizzo secondo le specifiche inspire, il codice assegnato dal comune, ecc.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property allows one to specify an identifier for the spatial object. The property is inherited by all the subclasses of spatial object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha codice</rdfs:label>
        <rdfs:label xml:lang="it">ha identificativo</rdfs:label>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasInternalAccess -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasInternalAccess">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/refersToExternalAccess"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/refersToExternalAccess"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:comment xml:lang="en">Inverse property of &quot;refersToExternalAccess&quot; used to link the external access to the internal one.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà inversa di &quot;si rifierisce a accesso esterno&quot;. Consente di collegare l&apos;accesso esterno all&apos;accesso interno</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha accesso interno</rdfs:label>
        <rdfs:label xml:lang="en">has internal access</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasLowerRank -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasLowerRank">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AdminUnitComponent"/>
        <rdfs:comment xml:lang="it">Questa proprietà mette in relazione due componenti dell&apos;indirizzo con nomi, dove la prima è meno specifica della seconda.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates two named address components, where the first is less specific than the second.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha livello più basso</rdfs:label>
        <rdfs:label xml:lang="en">has lower rank</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasNumber -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/CivicNumbering"/>
        <rdfs:comment xml:lang="it">Questa proprietà specializza la proprietà ha componente indirizzo per collegare l&apos;indirizzo al numero civico parte dello stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property specializes the property has address component in order to link the address with its part representing the street number (or housing number).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha numero civico</rdfs:label>
        <rdfs:label xml:lang="en">has street number</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasProvince -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasProvince">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/hasAddressComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Province"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;indirizzo alla Provincia. Esempio di Provincia: &quot;PA&quot;, &quot;BO&quot;, &quot;RM&quot;, ecc.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links the address with the Province.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha provincia</rdfs:label>
        <rdfs:label xml:lang="en">has province</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasRegion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/hasAddressComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Region"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un luogo/caratteristica con la Regione del paese. Regione; essa può essere  &quot;Lazio&quot;, &quot;Emilia Romagna&quot;, ecc.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links the address with the Region of the country.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha regione</rdfs:label>
        <rdfs:label xml:lang="en">has region</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasSOValidity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasSOValidity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/SpatialObject"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/TI/TimeInterval"/>
        <rdfs:comment xml:lang="it">Questa proprietà associa una validità temporale a un oggetto spaziale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property associate a temporal validity to a spatial object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha validità dell&apos;oggetto spaziale</rdfs:label>
        <rdfs:label xml:lang="en">has spatial object validity</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasSpatialCoverage -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasSpatialCoverage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Feature"/>
        <rdfs:comment xml:lang="en">Property used to model the spatial coverage of a thing of the modelled domain.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che consente di esprimere la copertura spaziale di una cosa del dominio da modellare.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha copertura spaziale</rdfs:label>
        <rdfs:label xml:lang="it">ha giurisdizione</rdfs:label>
        <rdfs:label xml:lang="en">has spatial coverage</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/hasStreetToponym -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/hasStreetToponym">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/hasAddressComponent"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/StreetToponym"/>
        <rdfs:comment xml:lang="it">Questa proprietà è usata per collegare l&apos;indirizzo al suo toponymo stradale (o odonimo)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property is used to  to link an address to the street  toponym component of it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">ha odonimo</rdfs:label>
        <rdfs:label xml:lang="it">ha toponimo stradale</rdfs:label>
        <rdfs:label xml:lang="en">has street toponym</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/isAddressComponentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/isAddressComponentOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/isAddressFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/isAddressFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Inverse property of has address that links the address to a thing.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà inversa di ha indirizzo che collega l&apos;indirizzo a una cosa del dominio da modellare.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">is address for</rdfs:label>
        <rdfs:label xml:lang="it">è indirizzo per</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/isAddressInTimeFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/isAddressInTimeFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Property that links a thing to its address in time reification.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che lega una cosa del dominio da modellare con la relazione n-aria indirizzo nel tempo.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV/"/>
        <rdfs:label xml:lang="en">is address in time for</rdfs:label>
        <rdfs:label xml:lang="it">è indirizzo nel tempo per</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/isGeometryFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/isGeometryFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Inverse property of &quot;hasGeometry&quot; that links a geometry to the related Thing of the domain.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà inversa di &quot;ha geometria&quot; che lega una geometria a una cosa del dominio modellato.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">is geometry for</rdfs:label>
        <rdfs:label xml:lang="it">è geometria per</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/issuedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/issuedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Identifier"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/COV/Organization"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un identificato all&apos;autorità che l&apos;ha rilasciato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links an Identifier with the Authority that issued it</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">identificativo rilasciato da</rdfs:label>
        <rdfs:label xml:lang="en">identifier issued by</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/nextAddress -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/nextAddress">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:comment xml:lang="it">Questa proprietà consente di modellare una sequenza ordinata di indirizzi (che potrebbero essere relazionati l&apos;uno con l&apos;altro come conseguenza di un cambio nella denominaziona avvenuta nel tempo). Nel caso specifico di questa proprietà, essa rappresenta la situazione &apos;address in time&apos; successiva nella sequenza.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property allows one to model an ordered sequence of addresses (that may be related to each other as a consequence of a change occured over time). In this specific case the property represents the next &apos;address in time&apos; situation in the sequence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">indirizzo successivo</rdfs:label>
        <rdfs:label xml:lang="en">next address</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/prevAddress -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/prevAddress">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:comment xml:lang="it">Questa proprietà consente di modellare una sequenza ordinata di indirizzi (che potrebbero essere relazionati l&apos;uno con l&apos;altro come conseguenza di un cambio nella denominaziona avvenuta nel tempo). Nel caso specifico di questa proprietà, essa rappresenta la situazione &apos;address in time&apos; precedente nella sequenza.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property allows one to model an ordered sequence of addresses (that may be related to each other as a consequence of a change occured over time). In this specific case the property represents the previous &apos;address in time&apos; situation in the sequence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">indirizzo precedente</rdfs:label>
        <rdfs:label xml:lang="en">previous address</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/refersToExternalAccess -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/refersToExternalAccess">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il numero interno (accesso interno) all&apos;accesso esterno (indirizzo)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links the internal access  to the external access (address)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">refers to external access</rdfs:label>
        <rdfs:label xml:lang="it">si riferisce ad accesso esterno</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/situatedWithin -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/situatedWithin">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AddressComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/AddressComponent"/>
        <rdfs:comment xml:lang="en">It is used to enable the model to express that the subtypes of address components in the dataset form a hierarchy e.g. like: a municipality within a province, which is in turn within a region, in turn within country.</rdfs:comment>
        <rdfs:comment xml:lang="it">La proprietà è utilizzata per abilitare il modello nell&apos;esprimere che una certa componente dell&apos;indirizzo nei dati forma una gerarchia. Esempio: un comune è situato in una provincia che è situata in una regione che è situata in uno stato.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">situated within</rdfs:label>
        <rdfs:label xml:lang="it">situato in</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/withAddress -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CLV/withAddress">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/AddressInTime"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:comment xml:lang="en">Property that links the situation of an address that changes over time to the address itself.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che collega la sitauzione di un indirizzo che cambia nel tempo all&apos;indirizzo stesso.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">con indirizzo</rdfs:label>
        <rdfs:label xml:lang="en">with address</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/RO/isRoleInTimeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/RO/isRoleInTimeOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/RO/withRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/RO/withRole">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/TI/atTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/TI/atTime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/TI/hasTemporalEntity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/TI/hasTemporalEntity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/follows -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/follows">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/precedes"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/precedes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:comment xml:lang="en">Relation between entities for expressing sequences.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione tra entità per esprimere sequenze.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="en">follows</rdfs:label>
        <rdfs:label xml:lang="it">segue</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/hasDescription -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/hasDescription">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/isDescriptionOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/isDescriptionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Description"/>
        <rdfs:comment xml:lang="en">Property that associates an entity with its description.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che associa un&apos;entità alla sua descrizione.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="it">ha descrizione</rdfs:label>
        <rdfs:label xml:lang="en">has description</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/hasMember -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/hasMember">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/isMemberOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/isMemberOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Collection"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:comment xml:lang="it">La proprietà che modella la relazione di membership.</rdfs:comment>
        <rdfs:comment xml:lang="en">The object property that models the membership relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="it">ha membro</rdfs:label>
        <rdfs:label xml:lang="en">has member</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/hasTopic -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/hasTopic">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/isTopicOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/l0/isTopicOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Topic"/>
        <rdfs:comment xml:lang="it">Questa object property permette di associare un entità ad un topic.</rdfs:comment>
        <rdfs:comment xml:lang="en">This object property allows to associate an entity with a topic.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="it">ha tema</rdfs:label>
        <rdfs:label xml:lang="en">has topic</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/isDescriptionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/isDescriptionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:comment xml:lang="en">Inverse property of &apos;has description&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà inversa di &apos;ha descrizione&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="en">is description of</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/isMemberOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/isMemberOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Collection"/>
        <rdfs:comment xml:lang="en">Inverse object property of has member.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione inversa di has member.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="en">is member of</rdfs:label>
        <rdfs:label xml:lang="it">membro di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/isTopicOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/isTopicOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Topic"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:comment xml:lang="it">La object property che permette di associare un tema ad un&apos;entità. E&apos; l&apos;inversa di hasTopic.</rdfs:comment>
        <rdfs:comment xml:lang="en">The object property that associates a topic with an entity. This is the inverse property of hasTopic.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="en">is topic of</rdfs:label>
        <rdfs:label xml:lang="it">è tema di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/l0/precedes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/l0/precedes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Entity"/>
        <rdfs:comment xml:lang="it">La relazione per rappresentare il predecessore di un entità in una sequenza.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation for represending the precedecessor of an entity in a sequence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="it">precede</rdfs:label>
        <rdfs:label xml:lang="en">precedes</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/arco/ontology/arco/numberOfComponents -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/arco/numberOfComponents">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/arco/numberOfParts"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero di oggetti componenti di un bene culturale identificato come serie o come insieme.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of components of a complex cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">number of components</rdfs:label>
        <rdfs:label xml:lang="it">numero di componenti</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: OG/QNT/QNTN; OG/QNT/QNTS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/numberOfCulturalPropertyParts -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/arco/numberOfCulturalPropertyParts">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/arco/numberOfParts"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/arco/CulturalPropertyPart"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero di esemplari di una stessa parte di un bene culturale (es.: il numero di denti di un reperto antropologico)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of specimens of the same cultural property part (es.: the number of the teeth of an anthropological material).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">number of cultural property part</rdfs:label>
        <rdfs:label xml:lang="it">numero di parte di bene culturale</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa AT 3.01: EL/ELE/ELEM</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/numberOfMembers -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/arco/numberOfMembers">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/arco/numberOfParts"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/arco/CulturalPropertyCollection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero di membri di un bene culturale che si identifica come una collezione (es.: serie)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of members of a cultural property that is a collection (e.g.: series)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">number of members</rdfs:label>
        <rdfs:label xml:lang="it">numero di membri</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: OG/QNT/QNTN; OG/QNT/QNTI; OG/QNT/QNTS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/numberOfParts -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/arco/numberOfParts">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero di parti di un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of parts of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">number of parts</rdfs:label>
        <rdfs:label xml:lang="it">numero di parti</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/numberOfResiduals -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/arco/numberOfResiduals">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/arco/numberOfParts"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/arco/CulturalPropertyResidual"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero di parti residuali, nel caso in cui si stia descrivendo un bene di cui si conservano più parti residuali.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of residuals (only if more than one) of a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">number of cultural property residual parts</rdfs:label>
        <rdfs:label xml:lang="it">numero di parti residuali di bene culturale</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>OG/QNT/QNTR</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/catalogue/ICCDIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/catalogue/ICCDIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/identifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta un codice assegnato a un&apos;entità dall&apos;ICCD. Si specializza in sottoproprietà (es.: codice univoco ICCD dell&apos;autore, codice univoco ICCD del riferimento bibliografico, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the identifier assigned to a cultural property by ICCD.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/catalogue"/>
        <rdfs:label xml:lang="en">ICCD identifier</rdfs:label>
        <rdfs:label xml:lang="it">codice univoco ICCD</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:constructQuery>prefix l0: &lt;https://w3id.org/italia/onto/l0/&gt; 

CONSTRUCT {
?thing l0:identifier ?id .
}

WHERE {
?thing a-cat:ICCDIdentifier ?id .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/ICCDIdentifier"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/catalogue/lastUpdateDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/catalogue/lastUpdateDate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/date"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/catalogue/Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la data dell&apos;ultimo aggiornamento della scheda di catalogo</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents information about the last update date of a catalogue record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/catalogue"/>
        <rdfs:label xml:lang="it">data dell&apos;ultimo aggiornamento</rdfs:label>
        <rdfs:label xml:lang="en">last update date</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/catalogue/systemRecordCode -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/catalogue/systemRecordCode">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/identifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/catalogue/CatalogueRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta l&apos;identificativo di sistema che viene associato all&apos;interno del sistema Sigec al file xml contenente una scheda di catalogo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the identifier associated in the context of the SIGECweb to the xml file containing a catalogue record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/catalogue"/>
        <rdfs:label xml:lang="it">identificativo di sistema</rdfs:label>
        <rdfs:label xml:lang="en">system record code</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:constructQuery>prefix arco-lite: &lt;https://w3id.org/italia/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?thing arco-lite:systemIdentifier ?id .
}

WHERE {
?thing a-cat:systemRecordCode ?id .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/systemIdentifier"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/construction-description/numberOfFloors -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/construction-description/numberOfFloors">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/construction-description/Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta  il numero di piani di un edificio.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of floors of a building.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/construction-description"/>
        <rdfs:label xml:lang="en">numbero of floors</rdfs:label>
        <rdfs:label xml:lang="it">numero di piani</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/construction-description/numberOfRooms -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/construction-description/numberOfRooms">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/arco/ontology/construction-description/Building"/>
                    <rdf:Description rdf:about="https://w3id.org/arco/ontology/construction-description/Floor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero di stanze di un edificio.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of rooms of a building.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/construction-description"/>
        <rdfs:label xml:lang="en">numbero of rooms</rdfs:label>
        <rdfs:label xml:lang="it">numero di stanze</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/RCSReason -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/RCSReason">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/CurrentInventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il codice della causale RCS (Ragioneria Centrale dello Stato) di aumento o diminuzione del valore del bene.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the code of the RCS causal (Central State Accounting Office) of increasing or decreasing property value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">RCS reason</rdfs:label>
        <rdfs:label xml:lang="it">causale RCS</rdfs:label>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UB/INP/INPU</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/abbreviation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/abbreviation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Edition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta l&apos;abbreviazione che identifica il riferimento bibliografico.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the abbreviation that identifies the bibliographic reference.</rdfs:comment>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">abbreviation</rdfs:label>
        <rdfs:label xml:lang="it">abbreviazione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">BIBR</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/acquisitionCost -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/acquisitionCost">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Acquisition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il costo di acquisizione</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the acquisition cost</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">acquisition cost</rdfs:label>
        <rdfs:label xml:lang="it">costo di acquisizione</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/ACQ/ACQC</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/acquisitionLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/acquisitionLocation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Acquisition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il luogo in cui è avvenuto un evento di acquisizione, generalmente espresso, in base ai dati disponibili, nella forma: &quot;Regione/sigla provincia/denominazione per esteso del Comune/località o toponimo&quot;</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the place where an acquisition event, generally expressed, based on the available data, took place, in the form: &quot;Region / abbreviation province / full name of the Municipality / locality or toponym&quot;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">acquisition location</rdfs:label>
        <rdfs:label xml:lang="it">luogo di acquisizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/ACQ/ACQL. BDI: DU/DUQ/DUQL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/activityPlaceAndPeriod -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/activityPlaceAndPeriod">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il luogo e il periodo di attvità di un autore.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the place and the period of activity of an author.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">activity place and period</rdfs:label>
        <rdfs:label xml:lang="it">luogo e periodo di attività</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa AUT: AU/AUT/AUTG</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/ageValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/ageValue">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/AgeInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta l&apos;età di un campione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the age of a specimen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">age</rdfs:label>
        <rdfs:label xml:lang="it">età</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>DA/SEM/SEME</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/alternativeName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/alternativeName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/name"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta una variante del nome di un agente.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents an alternative name of an agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">alternative name</rdfs:label>
        <rdfs:label xml:lang="it">variante del nome</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa AUT: AU/AUT/AUTE, AUTV. AU/AUV</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/areaRoomSquare -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/areaRoomSquare">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega uno scavo archeologico alla successione delle denominazioni, assegnate nell&apos;ambito dello scavo, al settore (o
l&apos;area), all&apos;ambiente e al quadrato da cui proviene il bene.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an archaeological excavation to the succession of the denominations, assigned in the excavation, to the sector (or
the area), to the environment and to the square from which the good comes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">area room square</rdfs:label>
        <rdfs:label xml:lang="it">settore ambiente quadrato</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/DSC/DSCQ</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/bibliographyICCDIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/bibliographyICCDIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/catalogue/ICCDIdentifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Bibliography"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il codice, assegnato dall&apos;ICCD, che individua il riferimento bibliografico in modo univoco a livello nazionale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the code, assigned by the ICCD, which identifies the bibliographic reference uniquely at national level.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">bibliography ICCD identifier</rdfs:label>
        <rdfs:label xml:lang="it">codice univoco ICCD della bibliografia</rdfs:label>
        <owl:deprecated rdf:resource="https://w3id.org/arco/ontology/arco-lite/ICCDIdentifier"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DO/BIB/BIBK</ns1:iccdNormTag>
        <ns2:constructQuery>CONSTRUCT {
?thing a-lite:ICCDIdentifier ?id .
}

WHERE {
?thing a-cd:bibliographyICCDIdentifier ?id .
}</ns2:constructQuery>
        <ns2:replacingQuery>select * {
?doc core:hasIdentifier ?NEWIdentifier .
?NEWIdentifier core:hasType core:LocalIdentifer ;
l0:identifier ?id .
}</ns2:replacingQuery>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/caption -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/caption">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/PhotographicDocumentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta una sintetica didascalia, se presente e utile alla comprensione di quanto documentato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents a synthetic caption, useful for understanding what is documented.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">caption</rdfs:label>
        <rdfs:label xml:lang="it">didascalia</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">FNTN</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/claySpecifications -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/claySpecifications">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/specifications"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta le specifiche su eventuali componenti significativi per lo studio del bene, nel caso di analisi su reperti in argilla.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents specifications on any significant components for the study of the entity, in case of analysis on clay findings.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">clay specifications</rdfs:label>
        <rdfs:label xml:lang="it">specifiche su pasta/argilla</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>RS/ALB/ALBA. CO/ALB/ALBA</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/collectionLeavingReason -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/collectionLeavingReason">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/CollectionMembership"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il motivo che ha determinato l&apos;uscita da una collezione di un bene culturale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the reason that led a cultural entity to the exit from a collection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">collection leaving reason</rdfs:label>
        <rdfs:label xml:lang="it">motivo di uscita dalla collezione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>UB/COL/COLM</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/completeBibliographicReference -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/completeBibliographicReference">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Edition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il riferimento bibliografico completo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the complete bibliographic reference.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">complete bibliographic reference</rdfs:label>
        <rdfs:label xml:lang="it">riferimento bibliografico completo</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale 4.00: DO/BIB/BIBM; RE/RCG/RCGS - versioni precedenti: DO/BIL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/contacts -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/contacts">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta i contatti di riferimento di un agente (persona, organizzazione), es. indirizzo, numeri di telefono e di fax, indirizzi di posta elettronica, ecc.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents contacts of an agent (i.e. email, telephone number...)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">contacts</rdfs:label>
        <rdfs:label xml:lang="it">contatti</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa SM 4.00: OS/OSE</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/culturalPropertyInventoryDescription -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/culturalPropertyInventoryDescription">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Inventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la descrizione patrimoniale del bene, con riferimento a quanto inserito nel modello 15 RCS a cura dell&apos;ente competente per tutela. Il dato viene richiesto direttamente agli uffici di catalogo/inventario dei relativi Istituti.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents a cultural entity inventory description.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">cultural property inventory description</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UB/INP/INPD</ns1:iccdNormTag>
        <ns2:constructQuery>CONSTRUCT {
?x core:description ?y .
}

WHERE {
?x a-cd:culturalPropertyInventoryDescription ?y .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/core/description"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/digitalFilename -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/digitalFilename">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/name"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Documentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il nome del file digitale che riproduce il documento, nel caso della documentazione allegata alla scheda di catalogo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the name of the digital file that reproduces the document.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">digital filename</rdfs:label>
        <rdfs:label xml:lang="it">nome del file digitale</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">FTAK, DRAK, VDCK, REGK, FNTK</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/documentationLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/documentationLocation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Documentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la collocazione del documento, che può anche essere espressa per mezzo della collocazione inventariale o dell&apos;identificativo (numerico o alfanumerico) della fonte o del documento.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents document location, which can also be expressed by inventory location or identifier.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">collocazione della documentazione</rdfs:label>
        <rdfs:label xml:lang="en">documentation location</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DO/FTA/FTAC, DO/DRA/DRAC, DO/VDC/VDCC, DO/REG/REGC, DO/FNT/FNTS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/documentationTitle -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/documentationTitle">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Documentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il titolo o la denominazione del documento.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents document title or denomination.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">documentation title</rdfs:label>
        <rdfs:label xml:lang="it">titolo della documentazione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">FTAM, DRAM, VDCA, REGZ, FNTT</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/editionLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/editionLocation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Edition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il luogo dell&apos;edizione di un&apos;opera.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents work&apos;s edition place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">edition location</rdfs:label>
        <rdfs:label xml:lang="it">luogo dell&apos;edizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normative VeAC e AT 3.01: DO/BSE/BSEL. Normative MI, S, OAC: AU/EDT/EDTL. Normativa F: PD/PDF/PDFL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/environmentalState -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/environmentalState">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ArchaeologicalFieldSurvey"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una ricognizione archeologica alla situazione ambientale al momento della ricognizione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an archaeological survey to environmental situation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">environmental state</rdfs:label>
        <rdfs:label xml:lang="it">situazione ambientale</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/RCG/RCGT - Versioni precedenti: RE/RCG/RCGU + RE/RCG/RCGC</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/estimatedValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/estimatedValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Estimate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il valore stimato durante il processo di stima di un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the value estimated in the context of an estimate process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">estimated value</rdfs:label>
        <rdfs:label xml:lang="it">valore stimato</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UB/COL/COLV; UB/INP/INP/INPA; UB/STI</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/expired -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/expired">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Copyright"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Questa proprietà indica se il copyright di un&apos;entità è scaduto o meno.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the expired copyright of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">expired</rdfs:label>
        <rdfs:label xml:lang="it">scaduto</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/expiryDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/expiryDate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/time"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta una data di scadenza, per esempio la data di scadenza dei diritti d&apos;autore su un oggetto (come un bene culturale).</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents an expiration date.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">data di scadenza</rdfs:label>
        <rdfs:label xml:lang="en">expiry date</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa F 4.00 e OAC: TU/CPR/CPRD. AD/ADS/ADSD</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/framework -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/framework">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ConservationIntervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la situazione in cui si svolge l&apos;intervento di restauro. Nel caso in cui l’intervento sul bene sia in corso al momento della schedatura e non risulti ancora concluso, il valore di questa proprietà sarà &quot;intervento in corso&quot; con l&apos;eventuale indicazione del luogo presso cui si sta effettuando.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the framework in which the restoration is carried out.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">framework</rdfs:label>
        <rdfs:label xml:lang="it">situazione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>RS/RST/RSTS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/historicalInformation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/historicalInformation">
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">historical information</rdfs:label>
        <rdfs:label xml:lang="it">informazioni storiche</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DA/NSC. - Normativa BNB: OG/OGT/OGTS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/informationGatheredOnSite -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/informationGatheredOnSite">
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta le informazioni raccolte sul luogo dove si trova il bene o sul luogo dove il bene è stato rilevato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents information collected on the place where the cultural entity is located or on the place where it was detected.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">information gathered on site</rdfs:label>
        <rdfs:label xml:lang="it">informazioni raccolte sul luogo</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DA/NRL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/insertionDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/insertionDate">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/InventorySituation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="it">Questa propretà rappresenta la data di inventariazione patrimoniale di un bene.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the date of insertion of an object in an inventory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">data di inserimento</rdfs:label>
        <rdfs:label xml:lang="en">insertion date</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale: UB/INP/INPR, UN/INV/INVD</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/inventoryLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/inventoryLocation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Inventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la collocazione dell&apos;inventario, cioè il luogo in cui è attualmente conservato l’inventario.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the location of the inventory about a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">collocazione dell&apos;inventario</rdfs:label>
        <rdfs:label xml:lang="en">inventory location</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>UB/INV/INVC</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/inventoryNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/inventoryNumber">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/InventorySituation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il codice di inventario nella forma numerica o alfanumerica attribuita dalla struttura conservativa (soprintendenza, museo, galleria, deposito, ecc.) che ha effettuato l&apos;inventariazione del bene.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the inventory identifier attributed by a juridical container to a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">codice d&apos;inventario</rdfs:label>
        <rdfs:label xml:lang="en">inventory number</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UB/INV/INVN - UB/INP/INPC</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/issueDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/issueDate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/date"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/arco/ontology/context-description/ExportImportCertification"/>
                    <rdf:Description rdf:about="https://w3id.org/arco/ontology/context-description/ProtectiveMeasure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la data di emissione di un provvedimento amministrativo o di una certificazione (es.: per la circolazione, esportazione/importazione di un bene culturale)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents issue date of an administrative provision or a certification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">data di emissione</rdfs:label>
        <rdfs:label xml:lang="en">issue date</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/NVC/NVCE; TU/ESP/ESPD</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/methodOfInsertion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/methodOfInsertion">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Inventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta, a testo libero, le modalità di acquisizione del bene nel patrimonio.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents how the cultural entity was inserted inside a collection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">method of insertion</rdfs:label>
        <rdfs:label xml:lang="it">modalità di acquisizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UB/INP/INPM</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/nationality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/nationality">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la nazionalità di una persona</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the nationality of a person</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">nationality</rdfs:label>
        <rdfs:label xml:lang="it">nazionalità</rdfs:label>
        <ns1:iccdNormTag>ICCD Norm AUT: AU/AUT/AUTF, AUTY. BDI and BDM: AT/ATT/ATTZ, AI/AIF/AIFZ, VI/VIF/VIFZ, FI/FIF/FIFZ. Normativa SM: MU/MUT/MUTZ.</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/noticeDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/noticeDate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/date"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ProtectiveMeasure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la data della notifica del provvedimento amministrativo al proprietario.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the date of notification of the administrative provision to the owner.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">data di notifica</rdfs:label>
        <rdfs:label xml:lang="en">notice date</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/NVC/NVCD</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/numberInCirculation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/numberInCirculation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la numerazione dell&apos;esemplare della fotografia o della stampa all&apos;interno della tiratura e il numero complessivo degli esemplari tirati, qualora la fotografia o la stampa risalgano a una tiratura. Nel caso delle fotografie, per tiratura si intende un insieme prestabilito e limitato di esemplari (uguali) tratti dallo stesso negativo o dalla stessa, ovvero non modificata, fotografia digitale (o dalla stessa serie di matrici), numerati progressivamente.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents photograph copies numbering.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">number in circulation</rdfs:label>
        <rdfs:label xml:lang="it">numero nella tiratura</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa F: PD/TRT; ICCD Normativa S: PD/TRT/TRTN</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/openingNoticeDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/openingNoticeDate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/date"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ProtectiveMeasure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la data (nella forma “aaaa/mm/gg”) della comunicazione di avvio del procedimento di dichiarazione di interesse al proprietario, possessore o detentore.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents date of interest declaration communication to the owner or holder.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">data di comunicazione di avvio</rdfs:label>
        <rdfs:label xml:lang="en">opening notice date</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/NVC/NVCI</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/overlapSpecifications -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/overlapSpecifications">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/specifications"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta le specifiche per effettuare sovrapposizioni con altri documenti utili per la lettura e l&apos;interpretazione dell&apos;immagine analizzata durante uan fotointerpretazione o fotorestituzione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents specifications to make overlaps with other documents useful for reading and interpreting image analyzed during a photointerpretation or photo-repayment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">overlap specifications</rdfs:label>
        <rdfs:label xml:lang="it">specifiche sulla sovrapposizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/FOI/FOIP</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/preferredAuthorshipAttribution -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/preferredAuthorshipAttribution">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/AuthorshipAttribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta l&apos;attribuzione preferita di autore o responsabilità</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the preferrred authorship attribution</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">attribuzione di autore preferita</rdfs:label>
        <rdfs:label xml:lang="en">preferred authorship attibution</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns2:constructQuery>CONSTRUCT {
?sit a-cd:preferredAuthorshipAttribution ?bool .
}

WHERE {
?sit a-cd:mainResponsibility ?bool .
}</ns2:constructQuery>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/proposedIntervention -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/proposedIntervention">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/l0/Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta le proposte per interventi conservativi di un bene.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the proposed intervention for conserving the involved cultural entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">proposed intervention</rdfs:label>
        <rdfs:label xml:lang="it">proposta di intervento</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa NT 4.00: CO/STP</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/provenance -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/provenance">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Inventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta, a testo libero, la provenienza del bene acquisito nel patrimonio.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents origin of the cultural entity acquired in the heritage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">provenance</rdfs:label>
        <rdfs:label xml:lang="it">provenienza</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UB/INP/INPP</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/pseudonym -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/pseudonym">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/name"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta uno pseudonimo</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents pseudonym</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">pseudonimo</rdfs:label>
        <rdfs:label xml:lang="en">pseudonym</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa AUT: AU/AUT/AUTP</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/recordingEquipment -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/recordingEquipment">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Recording"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta l&apos;attrezzatura tecnica impiegata per eseguire la registrazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the recording equipment used for making the recording.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">attrezzatura tecnica</rdfs:label>
        <rdfs:label xml:lang="en">recording equipment</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDI: DU/DUO/DUOA</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/registrationDateOrGU -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/registrationDateOrGU">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/date"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/ProtectiveMeasure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la data dell&apos;avvenuta trascrizione al registro immobiliare, quando trattasi di vincoli imposti con leggi che richiedano la trascrizione, o il numero della Gazzetta Ufficiale su cui è stato pubblicato il decreto.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the date of the registration or the number of the Official Journal on which the decree was published.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">data di registrazione o gazzetta ufficiale</rdfs:label>
        <rdfs:label xml:lang="en">registration date or official journal</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: TU/NVC/NVCR</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/relevantLegalAct -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/relevantLegalAct">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/CurrentInventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta, a testo libero, eventuali riferimenti a documenti (atti amministrativi; riproduzioni digitali di registri inventariali, ecc.) che interessano l&apos;acquisizione del bene nel patrimonio. Rappresenta anche i dati relativi ai registri inventariali in vigore, ma comunque dotati di qualità storica.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents any references to documents that affect cultural entity acquisition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">relevant legal act</rdfs:label>
        <rdfs:label xml:lang="it">riferimento agli atti</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: IUB/INP/INPO</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/report -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/report">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Survey"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il referto di un&apos;indagine archeometrica e diagnostica o di una tipologia particolare di bene archeologico, ovvero i reperti antropologici.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the report of a anthropological finding&apos;s archaeometric and diagnostic investigation.</rdfs:comment>
        <rdfs:comment>ICCD Normativa Trasversale 4.00: RE/IND/INDT - ICCD Normativa AT 3.00: IN/INI/INIR</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">referto</rdfs:label>
        <rdfs:label xml:lang="en">report</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/sex -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/sex">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Sex"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/SexInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il sesso dei una entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the sex of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">sesso</rdfs:label>
        <rdfs:label xml:lang="en">sex</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa AT: DA/STS/STSS. Normativa BDI: AT/ATT/ATTS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/signature -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/signature">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/name"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la firma o il monogramma</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the signature</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">firma</rdfs:label>
        <rdfs:label xml:lang="en">signature</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa AUT: AU/AUT/AUTF</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/stripRunAndFrameNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/stripRunAndFrameNumber">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/PhotographicDocumentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta, per le foto aeree, le informazioni relative alla strisciata e al fotogramma.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents aerial photos information about run and frame.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="en">strip run/frame number</rdfs:label>
        <rdfs:label xml:lang="it">strisciata/numero fotogramma</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">FTAR</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/subject -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/subject">
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il soggetto rappresentato da un bene culturale o il suo motivo decorativo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the subject of a cultural property, or its ornamental motif.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">soggetto</rdfs:label>
        <rdfs:label xml:lang="en">subject</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale: DA/AID/AIDI - Normativa F: SG/SGT/SGTI - Altre normative di versioni precedenti alla 4.00: OG/SGT/SGTI. DA/DES/DESU</ns1:iccdNormTag>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/hasCulturalPropertySubject"/>
        <ns2:replacingQuery>select * where {
?cp a-lite:hasCulturalPropertySubject ?NEWsubj .
?NEWsubj rdfs:label ?subj .
}</ns2:replacingQuery>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/subjectDescription -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/subjectDescription">
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresanta la descrizione del soggetto</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the description of a subject of a cultural property</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">descrizione del soggetto</rdfs:label>
        <rdfs:label xml:lang="en">subject description</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="en">Normativa D e F: OG/SGT/SGTD, SG/SGT/SGTD</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/surveyImageIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/surveyImageIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/identifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/SurveyImage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il codice identificativo che individua l&apos;immagine presa in esame nel corso di un&apos;indagine di fotointerpretazione o fotorestituzione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the identification code that identifies the image examined during a photo-interpretation or photo-restoration investigation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">identificativo immagine di indagine</rdfs:label>
        <rdfs:label xml:lang="en">survey image identifier</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: RE/FOI/FOID</ns1:iccdNormTag>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt;

CONSTRUCT  { ?doc a-lite:localIdentifier ?id .
}

WHERE 
      { ?doc a-cd:surveyImageIdentifier ?id .
 }</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/core/hasIdentifier"/>
        <ns2:replacingQuery>select * {
?img core:hasIdentifier ?NEWIdentifier .
?NEWIdentifier core:hasType core:LocalIdentifer ;
l0:identifier ?id .
}</ns2:replacingQuery>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/testResults -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/testResults">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà descrive i risultati dell&apos;attività di analisi</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the results of a test activity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">risultati dell&apos;analisi</rdfs:label>
        <rdfs:label xml:lang="en">test results</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">RS/ALB/ALBR. CO/ALB/ALBR</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/context-description/useCondition -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/context-description/useCondition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/context-description/Use"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/context-description/"/>
        <rdfs:label xml:lang="it">modalità di uso</rdfs:label>
        <rdfs:label xml:lang="en">use condition</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: UT/UTU/UTUM - BDM 2.00: UT/UTM - SMO, PTS 3.01: DA/UTM</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/current -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/current">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Questa porprietà indica se i dati relativi all&apos;istanza di un pattern sono attuali o no.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property indicates if data releated to an instance of a pattern is current or not</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="it">attuale</rdfs:label>
        <rdfs:label xml:lang="en">current</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/description -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/description">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta una descrizione associata a una certa entità, che viene arricchita con ulteriori dettagli che la descrivono.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a description associated to an entity, in order to add details and some more information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:label xml:lang="it">descrizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/hasIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/hasIdentifier"/>
    


    <!-- https://w3id.org/arco/ontology/core/identifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/identifier">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/core/Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;entità al suo codice identificativo.</rdfs:comment>
        <rdfs:comment>This property relates an entity with its identifier code.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="it">identificativo</rdfs:label>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/informationSource -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/informationSource">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la fonte da cui vengono prese le informazioni.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the source of information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="it">fonte dell&apos;informazione</rdfs:label>
        <rdfs:label xml:lang="en">information source</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>AU/CMM/CMMF</ns1:iccdNormTag>
        <ns1:iccdNormTag>Normativa trasversale e precedenti: *SGT/SGTL, RO/ROF/ROFM,, DT/DTM/DTMM, DT/ADT/ADTM, RE/REN/RENF, AU/DDC/DDCF, AU/FRU/FRUF, AU/ATB/ATBM, AU/AUT/AUTM, AU/AUF/AUFM, AU/AUI/AUIM, AU/AFB/AFBM, AU/AAT/AATM, AUAAFAAFM, PD/PDF/PDFM, UB/INP/INPA, UB/INV/INVS, UB/STI/STIM, AU/CMM/CMMF, LS/LTS/LTSF, LS/LVS/LVSF. Normativa BDI: AT/ATT/ATTE; AI/AIF/AIFH, VI/VIF/VIFH, FI/FIF/FIFH. Normativa SM: MU/MUT/MUTE. Normativa AT: DA/STS/STSC, DA/SEM/SEMC. Normativa BNPE: SR/SRRSRRM, RR/RRR/RRRM. Normativa BNPL: SP/SPD/SPDR, SPDS, SPDU, SPDD, SPDP, SPDH, SPDN, SPDA, SPDC, SPDB, SPDL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/note -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/note">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta eventuali note, relative a una certa informazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents notes associated to a piece of information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="en">note</rdfs:label>
        <rdfs:label xml:lang="it">note</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/specifications -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/specifications">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta eventuali specifiche, relative a una certa informazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents specifications associated to a piece of information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="en">specifications</rdfs:label>
        <rdfs:label xml:lang="it">specifiche</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/core/specifications"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/core/synonym -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/core/synonym">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un sinonimo a un&apos;entità</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a synonym to an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="it">sinonimo</rdfs:label>
        <rdfs:label xml:lang="en">synonym</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa BNM: SM/SMN/SMNS, RM/RMS/RMNS. Normativa BNP; SP/SPV. Normativa BNPE: SR/SRN/SRNC, SRNN, RR/RRN/RRNC, RRNN. Normativa BNZ: SZ/SZS/SZSN</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/cultural-event/timePeriodValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/cultural-event/timePeriodValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il valore del periodo di tempo che intercorre tra il verificarsi di due eventi membri di un evento ricorrente.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the value associated to the time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/cultural-event"/>
        <rdfs:label xml:lang="en">time period value</rdfs:label>
        <rdfs:label xml:lang="it">valore del periodo di tempo</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/accuracy -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/accuracy">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la validità, intesa come livello di accuratezza, di una misura osservata per un oggetto.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the validity, intended as accurancy level, of an observed measure for an object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description"/>
        <rdfs:label xml:lang="en">accuracy</rdfs:label>
        <rdfs:label xml:lang="it">accuratezza</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BNB, BNM, BNP, BNPE, BNPL, BNZ, CA, D, F, MA, MI, OA, OAC, PST, RA, S, SAS, SI, SM: MT/MIS/MIST

ICCD Normativa MI, S: MT/MIF/MIFV</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/italianTranslation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/italianTranslation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/AffixedElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la traduzione italiana della trascrizione di un testo contenuto in un&apos;iscrizione, un&apos;emblema, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the italian translation of a text transcription contained in an inscription, emblem etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">italian translation</rdfs:label>
        <rdfs:label xml:lang="it">traduzione italiana</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DA/ISE/ISEB</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/numberOfChildParticipants -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/numberOfChildParticipants">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/CommunicationMedium"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero dei bambini che attuano una comunicazione (verbale, musicale vocale).</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of the child participants to a communication (verbal, singing, kinesic).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">number of child participants</rdfs:label>
        <rdfs:label xml:lang="it">numero di partecipanti infantili</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDI: CU/CUV/CUVI; CU/CUM/CUMI</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/numberOfFemaleParticipants -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/numberOfFemaleParticipants">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/CommunicationMedium"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero delle persone di sesso femminile che attuano una comunicazione (verbale, musicale vocale, cinesica).</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of the male participants to a communication (verbal, singing, kinesic).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">number of female participants</rdfs:label>
        <rdfs:label xml:lang="it">numero di partecipanti femminili</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDI: CU/CUV/CUVF; CU/CUM/CUMF; CU/CUC/CUCF</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/numberOfMaleParticipants -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/numberOfMaleParticipants">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/CommunicationMedium"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il numero delle persone di sesso maschile che attuano una comunicazione (verbale, musicale vocale, cinesica)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the number of the male participants to a communication (verbal, singing, kinesic).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">number of male participants</rdfs:label>
        <rdfs:label xml:lang="it">numero di partecipanti maschili</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BDI: CU/CUV/CUVM; CU/CUM/CUMM; CU/CUC/CUCM</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/positionOnCulturalProperty -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/positionOnCulturalProperty">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la posizione di un oggetto (es.: elementi come stemmi, emblemi, timbri, etc., oppure i soggetti rappresentati) rispetto all&apos;intero bene o a una sua specifica parte.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents a cultural entity&apos;s postion (e.g. elements like crests, emblems, stamps or the depicted subjects), with respect to the whole entity or to its specific part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">position on cultural property</rdfs:label>
        <rdfs:label xml:lang="it">posizione su bene culturale</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale 4.00: DA/ISE/ISEP - Normative di versioni precedenti: DA/STM/STMP; DA/ISR/ISRP - Normativa A: LI/LSI/LSIU - Normativa PST: OG/SGT/SGTP - ICCD Normative MA, CA, SI, SAS: MC/CMN/CMNP - ICCD Normative D, OA, RA, BDM (v.1 e v.2): OG/OGT/OGTP</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/proposedIntervention -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/proposedIntervention">
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta eventuali proposte per interventi conservativi, dopo aver valutato le condizioni del bene al momento della sua catalogazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents potential proposals for conservative interventions after evaluating the cultual entity&apos;s conditions at time of its cataloguing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">proposed intervention</rdfs:label>
        <rdfs:label xml:lang="it">proposte di interventi</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>CO/STP</ns1:iccdNormTag>
        <ns2:constructQuery>CONSTRUCT {?class a-cd:proposedIntervention ?int .}
WHERE {?class a-dd:proposedIntervention ?int.}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/context-description/proposedIntervention"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/storageConditions -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/storageConditions">
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta informazioni sulle condizioni ambientali e microclimatiche in cui si trova il bene al momento della catalogazione ed eventuali indicazioni per una sua corretta conservazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents informations about the storage conditions of a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="it">modalità di conservazione</rdfs:label>
        <rdfs:label xml:lang="en">storage conditions</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>CO/STD</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/transcript -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/transcript">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;iscrizione, un emblema, etc., alla trascrizione del testo, utilizzando scioglimenti e integrazioni scientificamente accettati.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property connects an inscription, emblem etc., to the text&apos;s transcription, using scientifically accepted integrations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">transcript</rdfs:label>
        <rdfs:label xml:lang="it">trascrizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: DA/ISE/ISEI - Normative di versioni precedenti: DA/ISR/ISRI. DA/DES/DESG, DESL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/manufacturingDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/manufacturingDate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/TI/date"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la data di preparazione del reperto o del preparato</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the date of manufacturing of the sample or of the preparation</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="it">data di preparazione</rdfs:label>
        <rdfs:label xml:lang="en">manufacturing date</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BNB: DB/DBR/DBRD, DB/DBX/DBXO, DB/DBS/DBSD, DB/DB/DBP/DBPD.</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/arco/ontology/natural-specimen-description/sampleLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/arco/ontology/natural-specimen-description/sampleLocation">
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description/Sample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la collocazione che l’oggetto ha nella collezione ancillare di cui fa parte</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the location of the object inthe ancillar collection</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/natural-specimen-description"/>
        <rdfs:label xml:lang="it">collocazione del reperto</rdfs:label>
        <rdfs:label xml:lang="en">sample location</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa BNB: DB/DBC/DBCC, DB/DBX/DBXC, DB/DBS/DBSC, DB/DB/DBP/DBPC.</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/acronym -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/acronym">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/name"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Province"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">La sigla automobilistica con cui viene indicata la provincia.</rdfs:comment>
        <rdfs:comment xml:lang="en">The acronym of the province that is typically used over the Italian territory for the license plate.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">acronym province</rdfs:label>
        <rdfs:label xml:lang="it">sigla automobilistica</rdfs:label>
        <rdfs:label xml:lang="it">sigla provincia</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/alt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/alt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta l&apos;altitudine, ovvero l&apos;altezza di un oggetto spaziale rispetto alla superficie del livello medio del mare.. E&apos;  proprietà associata alla geometria. Nel caso di geometria associata all&apos;indirizzo, la proprietà  rappresenta l&apos;altezza ortometrica dell’accesso esterno (civico) espressa nei sistemi di riferimento altimetrici nazionali ufficiali.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property represents the altitude, i.e., the height of an object or point in relation to sea level or ground level. It is associated with the geometry.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">altitude</rdfs:label>
        <rdfs:label xml:lang="it">altitudine</rdfs:label>
        <rdfs:label xml:lang="it">quota</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: GE/GEC/GECZ - Normative precedenti: GP/GPC/GPCL</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/building -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/building">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Numero arabo assegnato all’edificio cui si accede alle scale o agli accessi interni, ove presente. Questa proprietà potrebbe essere utilizzata anche per identificare un numero di padiglione.</rdfs:comment>
        <rdfs:comment xml:lang="en">When available, it represents the arabic number assigned to the building accessed by the stairs or internal accesses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">building</rdfs:label>
        <rdfs:label xml:lang="it">edificio</rdfs:label>
        <rdfs:label xml:lang="it">palazzo</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/coordinate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/coordinate">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta le coordinate geografiche della Geometria.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the geographical coordinate of the Geometry</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">coordinata geografica</rdfs:label>
        <rdfs:label xml:lang="en">geographical coordinate</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale: GE/GEC - versioni precedenti: GP/GPD; GA/GAPD; GL/GLS</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/coordinateSystem -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/coordinateSystem">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">Property used to indicate the coordinate system or reference system (e.g., WGS84, ETRS89, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà utilizzata per indicare il sistema di coordinate o sistema di riferimento (e.g., WGS84, ETRS89, ecc,.)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">coordinate system of reference</rdfs:label>
        <rdfs:label xml:lang="it">sistema di coordinate di riferimento</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: GE/GEP - Normative precedenti: GA/GAP; GL/GLP; GP/GPP</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/exponent -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/exponent">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/CivicNumbering"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/InternalAccess"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Parte letterale del numero civico, ove presente o eventuale esponente attribuito al numero interno.  In quest&apos;ultimo caso, l’utilizzo va preventivamente concordato con l’Istat</rdfs:comment>
        <rdfs:comment xml:lang="en">When available, it represents the literal part of the number of the address. It can be used associated with both the external and internal number.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">esponente</rdfs:label>
        <rdfs:label xml:lang="en">exponent</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/flatNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/flatNumber">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="it">Valore del numero interno assegnato all’accesso interno secondo la successione naturale dei numeri;</rdfs:comment>
        <rdfs:comment xml:lang="en">Value of the internal number assigned to the internal access according to the natural sequence of numbers</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">flat number</rdfs:label>
        <rdfs:label xml:lang="it">interno</rdfs:label>
        <rdfs:label xml:lang="it">numero appartamento</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/floor -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/floor">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Numero del piano su cui è ubicato l’accesso interno, ove presente;</rdfs:comment>
        <rdfs:comment xml:lang="en">When available, the property represents the floor number on which the internal access is located.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">floor</rdfs:label>
        <rdfs:label xml:lang="it">piano</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/fullAddress -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/fullAddress">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">L&apos;indirizzo completo scritto come una stringa. L&apos;uso di questa proprietà  aiuta a comprendere l&apos;indirizzo completo evitando possibili errori derivanti dal frazionamento dello stesso nelle sue rispettive componenti.</rdfs:comment>
        <rdfs:comment xml:lang="en">The complete address written as a string, with or without formatting. The use of this property allows one not to incur in any misunderstandings that might arise through the breaking up of an address into its component parts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">full address</rdfs:label>
        <rdfs:label xml:lang="it">indirizzo completo</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/identifierType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/identifierType">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">La proprietà consente di modellare il tipo di identificativo. Per esempio esistono diversi tipi di codici: il codice ISTAT o il codice del comune o l&apos;identificativo INSPIRE.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property allows one to specifies the type of identifier. For instance there can be the identifier assigned by the Italian Insttute of Statistics or the identifier assigned by the Municipalities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">identifier type</rdfs:label>
        <rdfs:label xml:lang="it">tipo identificativo</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/lat -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/lat">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/coordinate"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà consente di specificare la latitudine. E&apos; associata alla geometria. Nel caso dell&apos;ANNCSU è espressa nel Sistema di riferimento geodetico nazionale, costituito dalla realizzazione ETRF2000 – all’epoca 2008.0 – del Sistema di riferimento geodetico Europeo ETRS89</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the latitude. It is associated with the Geometry.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">latitude</rdfs:label>
        <rdfs:label xml:lang="it">latitudine</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: GE/GEC/GECY - Normative precedenti: GP/GPD/GPDP/GPDPY; GA/GAD/GADP/GADPY; GL/GLD/GLDP/GLDPY</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/long -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/long">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/coordinate"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la longitudine ed è associata alla geometria. Nell&apos;ambito dell&apos;ANNCSU la longitudine dell&apos;accesso è espressa nel Sistema di riferimento geodetico nazionale, costituito dalla realizzazione ETRF2000 – all’epoca 2008.0 – del Sistema di riferimento geodetico Europeo ETRS89</rdfs:comment>
        <rdfs:comment xml:lang="en">This property allows one to specify the longitude. It is associated with the Geometry</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">longitude</rdfs:label>
        <rdfs:label xml:lang="it">longitudine</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: GE/GEC/GECX - Normative precedenti: GP/GPD/GPDP/GPDPX; GA/GAD/GADP/GADPX; GL/GLD/GLDP/GLDPX</ns1:iccdNormTag>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/metric -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/metric">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/CivicNumbering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Valore del numero civico assegnato all’accesso esterno espresso in metri, utilizzato in caso di adozione del sistema metrico anziché della successione naturale dei numeri</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">metric</rdfs:label>
        <rdfs:label xml:lang="it">valore metrico</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/officialStreetName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/officialStreetName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/name"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/StreetToponym"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">Property that identifies in the street toponym the official street name</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che identifica la parte di toponimo stradale chiamata DUF - Denominazione Urbanistica uFficiale</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">DUF (Denominazione Urbanistica uFficiale)</rdfs:label>
        <rdfs:label xml:lang="it">nome della strada</rdfs:label>
        <rdfs:label xml:lang="en">official street name</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/peculiarity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/peculiarity">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/CivicNumbering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Valore utilizzato in presenza di uno specifico metodo di classificazione della numerazione civica, validata dall’Istat (es. ROSSO e NERO); Potrebbe forse essere utilizzato anche per indicare A, B , bis che si riferiscono ai numeri civici di accesso esterno.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">peculiarity</rdfs:label>
        <rdfs:label xml:lang="it">specificità</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/postCode -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/postCode">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/l0/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta il CAP in un indirizzo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the value of the zip code in an address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">CAP</rdfs:label>
        <rdfs:label xml:lang="it">Codice Avviamento Postale</rdfs:label>
        <rdfs:label xml:lang="en">post code</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/serialization -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/serialization">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà indica la serializzazione della geometria (gml, KML, ecc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the serialization of the geometry object (e.g., kml, gml, etc.),</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">serialization</rdfs:label>
        <rdfs:label xml:lang="it">serializzazione della geometria</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/staircase -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/staircase">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Parte letterale dell&apos;accesso interno (numero interno) assegnata alla scala, ove presente.</rdfs:comment>
        <rdfs:comment xml:lang="en">When available, the property represents the literal part of the internal number of the address that is assigned to the staircase.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">scala</rdfs:label>
        <rdfs:label xml:lang="en">staircase</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/streetNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/streetNumber">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/CivicNumbering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="it">Valore del numero civico assegnato all’accesso esterno secondo la successione naturale dei numeri;</rdfs:comment>
        <rdfs:comment xml:lang="en">Value of the street number that is assigned to the external access according to the natural sequence of numbers</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="en">street number</rdfs:label>
        <rdfs:label xml:lang="it">valore civico</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/toponymQualifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/toponymQualifier">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/StreetToponym"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Questa proprietà è utilizzata per specificare il DUG (Denominazione Urbanistica Generica) o qualificatore di toponimo (e.g., via, vicolo, viale, piazza, ecc.) dell&apos;odonimo/toponimo</rdfs:comment>
        <rdfs:comment xml:lang="en">This property is used to represent the Italian DUG (Denominazione Urbanistica Generica) or toponym qualifier (e.g., via, viale, piazza, ecc.) of the street toponym</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">denominazione urbanistica generica (DUG)</rdfs:label>
        <rdfs:label xml:lang="it">qualificatore del toponimo</rdfs:label>
        <rdfs:label xml:lang="en">toponym qualifier</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/CLV/yard -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/CLV/yard">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/InternalAccess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">If available, the property represents the romanic number assigned to each private space (yard and similar) to which access buildings or other internal accesses,</rdfs:comment>
        <rdfs:comment xml:lang="it">Numero romano assegnato a ciascun spazio privato (cortile, corte e simili) cui si accede agli edifici o agli accessi interni, ove presente;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/CLV"/>
        <rdfs:label xml:lang="it">cortile</rdfs:label>
        <rdfs:label xml:lang="en">yard</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/SM/URL -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/SM/URL"/>
    


    <!-- https://w3id.org/italia/onto/TI/date -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/TI/date"/>
    


    <!-- https://w3id.org/italia/onto/TI/modified -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/TI/modified"/>
    


    <!-- https://w3id.org/italia/onto/TI/time -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/TI/time"/>
    


    <!-- https://w3id.org/italia/onto/l0/description -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/l0/description">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Datatype property che associa un valore letterale a una cosa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Datatype property that associates a literal value with a thing</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:label xml:lang="it">descrizione</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/l0/identifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/l0/identifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0/"/>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: CT/CTM/CTMS
ICCD Normativa BNB: AC/ACN</ns1:iccdNormTag>
        <ns2:constructQuery>CONSTRUCT   { ?acq a a-cd:Acquisition;
core:hasType ?type.
 }
WHERE       { ?acq a a-cd:Acquisition;
a-cd:hasAcquisitionType ?type.
 }

prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt;
CONSTRUCT   { ?cp a-lite:localIdentifier ?id.
 }
WHERE       { ?cp a-cd:surveyImageIdentifier ?id.
 }</ns2:constructQuery>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/cities"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/regions"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/countries/foreign-countries"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/countries/italy"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/l0/name -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/l0/name">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0/"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/cities"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/regions"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/countries/foreign-countries"/>
        <ns4:controlledVocabulary rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/countries/italy"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/italia/onto/l0/positionInSequence -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/onto/l0/positionInSequence">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">It represents the position of an item within a sequence</rdfs:comment>
        <rdfs:comment xml:lang="it">Rappresenta la posizione di un elemento in una sequenza</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/onto/l0"/>
        <rdfs:label xml:lang="en">position in sequence</rdfs:label>
        <rdfs:label xml:lang="it">posizione nella sequenza</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile - proprietà aggiunta il 16 aprile 2020 alla versione dell&apos;ontologia 0.8</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable - property added on April 16th 2020 to version 0.8 of the ontology</owl:versionInfo>
    </owl:DatatypeProperty>
    


