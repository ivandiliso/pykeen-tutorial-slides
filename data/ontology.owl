                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isCharacteristicOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/catalogue/isCataloguingLevelOf"/>
