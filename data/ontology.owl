    <!-- https://w3id.org/arco/ontology/location/hasTerritorialArea -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasTerritorialArea">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isTerritorialAreaOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/hasAddressComponent"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/isAddressComponentOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isTerritorialAreaOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/location/HistoricalAddress"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Feature"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un indirizzo a un&apos;area di appartenenza territoriale, che può non coincidere con l&apos;area amministrativa.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links an address to a territorial area, which may not coincide with the administrative area, to which a cultural property belongs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="it">ha area di appartenenza territoriale</rdfs:label>
        <rdfs:label xml:lang="en">has territorial area</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa Trasversale 4.00: LS/LCS/LCSR, LS/LCS/LCST, LS/LCS/LCSI. ICCD</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasTimeIndexedTypedLocation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasTimeIndexedTypedLocation">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isTimeIndexedTypedLocationOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isTimeIndexedTypedLocationOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;entità a una sua localizzazione tipizzata nel tempo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links an entity to its typified location over time.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="it">ha localizzazione tipizzata nel tempo</rdfs:label>
        <rdfs:label xml:lang="en">has time indexed typed location</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale: LC; LA; per normativa F: anche LR</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasTypeOfContext -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasTypeOfContext">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isTypeOfContextOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasConcept"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/hasType"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isConceptOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isTypeOf"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isTypeOfContextOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/TypeOfContext"/>
        <rdfs:comment xml:lang="it">Questa proprietà permette di collegare un&apos;entità al tipo di contesto (urbano, suburbano, extraurbano, territoriale, subacqueo) in cui si trova.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates an entity to the type of context where the cultural property is located (i.e. urban context, suburban context, extra-urban context, territorial context, underwater context).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="it">ha tipo di contesto geografico</rdfs:label>
        <rdfs:label xml:lang="en">has type of geographical context</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag xml:lang="it">ICCD Normativa Trasversale: LC/PVZ; LA/PRZ</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isCadastralCityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isCadastralCityOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/location/isCadastralEntityOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/hasCadastralEntity"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/City"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/CadastralIdentity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega il comune a cui è intestato il foglio di mappa catastale, riportato nella forma attestata nel catasto all&apos;identità catastale di un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links the municipality to which the cadastral map is registered, as attested by the cadastre, to a cadastral identity of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is cadastral city of</rdfs:label>
        <rdfs:label xml:lang="it">è città catastale di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isCadastralEntityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isCadastralEntityOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/location/CadastralEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/CadastralIdentity"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;entità catastale, intesa come oggetti spaziali, a alla sua identità catastale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links a cadastral entity, understood as spatial object, to its cadastral identity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is cadastral entity of</rdfs:label>
        <rdfs:label xml:lang="it">è entità catastale di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isCadastralIdentityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isCadastralIdentityOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/location/CadastralIdentity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega l&apos;insieme delle informazioni catastali, relative a una delle sue localizzazioni (storica, attuale, di rinvenimento, ecc.), a un bene culturale.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links all the cadastral information related to one of its locations: i.e. historical location, current location, finding location, etc., to a cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is cadastral identity of</rdfs:label>
        <rdfs:label xml:lang="it">è identitià catastale di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isClericalAdministrativeAreaOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isClericalAdministrativeAreaOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/italia/onto/CLV/isAddressComponentOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/CLV/hasAddressComponent"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/ClericalAdministrativeArea"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un&apos;area amministrativa ecclesiastica (ad es. una diocesi) al suo indirizzo.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a clerical administrative area (e.g. a diocese) to its address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is clerical administrative area of</rdfs:label>
        <rdfs:label xml:lang="it">è area amministrativa ecclesiastica di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa trasversale: LA/PRE, LC/PVE</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isClimateSituationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isClimateSituationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isEventOrSituationInTimeOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasEventOrSituationInTime"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/location/ClimateSituation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega la situazione climatica all&apos;ambiente</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates the climate situation to the ambient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is climate situation of</rdfs:label>
        <rdfs:label xml:lang="it">è situazione climatica di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isContainedInCadastre -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isContainedInCadastre">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/location/CadastralIdentity"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/Cadastre"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una identità catastale al catasto in cui è registrata.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links a cadastral identity to the cadastre in which it is registered.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is contained in cadastre</rdfs:label>
        <rdfs:label xml:lang="it">è contenuta nel catasto</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>LS/CSS/CSSD</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isCulturalInstituteOrSiteOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isCulturalInstituteOrSiteOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalInstituteOrSite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un luogo o istituto della cultura (contenitore giuridico) al bene culturale</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links a cultural institute or site to a cultural property</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is cultural institute or site of</rdfs:label>
        <rdfs:label xml:lang="it">è luogo o istituto della cultura di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isCulturalPropertyAddressOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isCulturalPropertyAddressOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CLV/Address"/>
        <rdfs:range rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:comment xml:lang="it">Questa proprietà rappresenta la relazione che collega l&apos;indirizzo della localizzazione fisica attuale, al momento della catalogazione, con il bene culturale catalogato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property represents the relationship that links the address of the current physical location at the cataloging time to the catalogued cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="en">is cultural property address of</rdfs:label>
        <rdfs:label xml:lang="it">è indirizzo del bene culturale</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns2:constructQuery>prefix a-lite: &lt;https://w3id.org/arco/ontology/arco-lite/&gt; 

CONSTRUCT {
?add a-lite:issCulturalPropertyAddressOf ?thing .
}

WHERE {
?add a-loc:isCulturalPropertyAddressOf ?thing .
}</ns2:constructQuery>
        <ns2:replacedBy rdf:resource="https://w3id.org/arco/ontology/arco-lite/isCulturalPropertyAddressOf"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/isFluidDynamismOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/isFluidDynamismOf">
