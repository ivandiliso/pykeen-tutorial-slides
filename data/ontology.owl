                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isSoilOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isSoilOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/Soil"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega una cosa al suolo</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a thing to the soil</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="it">ha suolo</rdfs:label>
        <rdfs:label xml:lang="en">has soil</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/location/hasStratigraphicArea -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/location/hasStratigraphicArea">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/location/isStratigraphicAreaOf"/>
