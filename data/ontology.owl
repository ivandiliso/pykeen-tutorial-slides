        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/location/ShadeTolerance"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un ambiente naturale alla sua situazione luminosa.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a natural environment with its shade tolerance.</rdfs:comment>
