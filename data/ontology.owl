        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa BNB: SB/DBV/DBVA, RB/RBR/RBRA, SB/ABC/ABCA, TB/TBI/TBIA. Normativa BNM: SM/SMT/SMTA, RM/RMT/RMTA. Normativa BNP: SP/SPS/SPSL. Normativa BNZ: SZ/SZS/SZSL. Normativa BNPE: RR/RRD/RRDA, SR/SRT/SRTA, RR/RRT/RRTA. Normativa BNPL: SP/SPT/SPTA, RP/RPT/RPTA</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/isAgentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/isAgentOf">
