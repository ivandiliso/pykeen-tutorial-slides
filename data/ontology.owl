        <rdfs:domain rdf:resource="http://dati.beniculturali.it/cis/CulturalEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/l0/Location"/>
        <rdfs:comment xml:lang="it">Questa proprietà collega un saggio stratigrafico al settore in cui il saggio è stato effettuato.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property relates a stratigraphic record to the room in which it took place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/location/"/>
        <rdfs:label xml:lang="it">ha settore</rdfs:label>
        <rdfs:label xml:lang="en">has stratigraphic room</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa SAS: OG/OGT/OGTY</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


