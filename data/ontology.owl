        <rdfs:label xml:lang="it">è definito da sistema di classificazione</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Normativa trasversale e normative precedenti 4.00: SG/CLF/CLFT. SM: CL/CLA/CLAA. Normativa BNM: SM/SMS/SMSX, SMSC, SMSD, RM/RMS/RMSX, RMSK</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/isDescribedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/isDescribedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa della proprietà &quot;descrive&quot;, è stata creata come proprietà generica di sottoproprietà specifiche, e rappresenta la relazione tra un&apos;entità descritta da un&apos;altra entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property, inverse property of &quot;describes&quot;, was created as a generic property for specific subproperties, and represents the relationship between an entity described by another entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/core"/>
        <rdfs:label xml:lang="en">is described by</rdfs:label>
        <rdfs:label xml:lang="it">è descritto da</rdfs:label>
        <owl:versionInfo xml:lang="it">instabile</owl:versionInfo>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>Tutte le schede di catalogo descrivono un bene. ICCD Normativa Tr: AC/ACS, AC/MOD</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/isDescriptionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/isDescriptionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
