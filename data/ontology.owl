            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isClassificationSystemOf"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/isClassificationSystemOf"/>
