        <owl:versionInfo xml:lang="en">unstable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normativa trasversale: SG/CLF.</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/core/isClassificationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/isClassificationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
