        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/denotative-description/AgeRange"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/denotative-description/CommunicationMedium"/>
        <rdfs:comment xml:lang="it">Questa è la proprietà inversa di &quot;coinvolge fascia d&apos;età&quot;.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the inverse property of &quot;involves age range&quot;.</rdfs:comment>
