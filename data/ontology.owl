        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>CM/CMP/CMPD; CM/RVM/RVMD; CM/AGG/AGGD</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/catalogue/editingTimeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/catalogue/editingTimeOf">
