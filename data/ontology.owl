        </rdfs:subPropertyOf>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/arco/ontology/core/hasPart"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/arco/ontology/arco/CulturalProperty"/>
        <rdfs:range rdf:resource="https://w3id.org/arco/ontology/arco/ComplexCulturalProperty"/>
        <ns3:isNativeTo>https://w3id.org/arco/pattern/cultural-property-component-of/</ns3:isNativeTo>
        <rdfs:comment xml:lang="it">Questa proprietà, inversa a &quot;ha componente&quot;, collega una delle parti componenti di un bene culturale complesso al bene complesso stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property, inverse of &quot;has component&quot;, relates a component of a complex cultural property to the complex cultural property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">is cultural property component of</rdfs:label>
        <rdfs:label xml:lang="it">è parte componente di bene culturale</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>OG/OGT/OGTP</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/arco/isCulturalPropertyResidualOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/arco/isCulturalPropertyResidualOf">
