        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/arco"/>
        <rdfs:label xml:lang="en">is cultural property cataloguing category of</rdfs:label>
        <rdfs:label xml:lang="it">è categoria di bene culturale basata su catalogazione di</rdfs:label>
