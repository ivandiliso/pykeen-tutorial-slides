    <!-- https://w3id.org/arco/ontology/core/isComponentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/core/isComponentOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arco/ontology/core/isPartOf"/>
