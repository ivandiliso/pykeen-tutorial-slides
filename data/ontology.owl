        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
        <ns1:iccdNormTag>ICCD Normative Beni naturalistici: IM/IMA/IMAC; ET/ETA/ETA, IM/IMG, , IMIML; IR/IRG, IR/IRL, ET/ETG, ET/ETL, IR/IRA/*</ns1:iccdNormTag>
    </owl:ObjectProperty>
    


