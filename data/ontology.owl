        <rdfs:comment xml:lang="en">This is the inverse property of &quot;has accessory&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/arco/ontology/denotative-description/"/>
        <rdfs:label xml:lang="en">is accessory of</rdfs:label>
        <rdfs:label xml:lang="it">è accessorio di</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/denotative-description/isAgeRangeInvolvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/denotative-description/isAgeRangeInvolvedIn">
